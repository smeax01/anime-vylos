---
import { Play, Star, Bookmark } from "lucide-astro";

interface Props {
  id: number | string;
  image: string;
  title: string;
  type: string;
  rating?: number;
  tag?: string;
  episode?: number;
}

const { id, image, title, type, rating, tag, episode } = Astro.props;
---

<a
  href={`/anime/${id}${episode ? `?ep=${episode}` : ""}`}
  class="group block w-full"
>
  <div class="relative transition-all duration-300">
    <!-- Aspect Ratio Container (Netflix style) -->
    <div
      class="relative aspect-[2/3] w-full rounded-xl overflow-hidden bg-gray-200 dark:bg-gray-800 shadow-sm border border-gray-100 dark:border-gray-800 group-hover:border-blue-500/50 transition-colors"
    >
      <!-- Image with internal zoom only -->
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
      />

      <!-- Overlays -->
      <div
        class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
      >
        <div
          class="bg-blue-600 p-3 rounded-full text-white shadow-xl transform scale-75 group-hover:scale-100 transition-transform duration-300"
        >
          <Play size={24} fill="currentColor" />
        </div>
      </div>

      <!-- Top Badges -->
      <div
        class="absolute top-2 left-2 right-2 flex justify-between items-start pointer-events-none"
      >
        {
          tag ? (
            <span class="bg-blue-600 text-white text-[10px] font-black px-2 py-0.5 rounded shadow-lg uppercase tracking-widest">
              {tag}
            </span>
          ) : (
            <div class="flex flex-col gap-1">
              {episode && (
                <span class="bg-blue-600 text-white text-[10px] font-black px-2 py-0.5 rounded shadow-lg uppercase tracking-widest">
                  ÉP. {episode}
                </span>
              )}
              {rating && (
                <div class="bg-gray-950/80 backdrop-blur-md px-1.5 py-0.5 rounded flex items-center gap-1 text-yellow-400 text-[9px] font-bold border border-white/10 shadow-lg w-fit">
                  <Star size={10} fill="currentColor" />
                  {(rating / 10).toFixed(1)}
                </div>
              )}
            </div>
          )
        }
      </div>

      <!-- Progress bar for history cards -->
      {
        episode && (
          <div class="absolute bottom-0 left-0 w-full h-1 bg-gray-900/40">
            <div class="h-full bg-blue-600" style="width: 100%" />
          </div>
        )
      }
    </div>

    <!-- Info Section (Fixed Height to prevent layout mismatch) -->
    <div class="mt-3 space-y-1">
      <h3
        class="text-xs md:text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2rem] md:min-h-[2.5rem] group-hover:text-blue-500 transition-colors"
      >
        {title}
      </h3>
      <div class="flex items-center gap-2">
        <span
          class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate"
        >
          {type || "TV"}
        </span>
      </div>
    </div>
  </div>
</a>
