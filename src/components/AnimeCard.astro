---
import { Play } from "lucide-astro";

interface Props {
  id: number | string;
  image: string;
  title: string;
  type: string;
  episode?: number;
}

const { id, image, title, type, episode } = Astro.props;
---

<a
  href={`/anime/${id}${episode ? `?ep=${episode}` : ""}`}
  class="group block w-full"
>
  <div class="relative flex flex-col h-full">
    <!-- Image with very subtle border and standard rounding -->
    <div
      class="relative aspect-[2/3] w-full rounded-md overflow-hidden bg-gray-100 dark:bg-gray-800 transition-all duration-300"
    >
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      />

      <!-- Crunchyroll style simple overlay -->
      <div
        class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      >
      </div>

      <!-- Episode Badge if available -->
      {
        episode && (
          <div class="absolute bottom-2 left-2">
            <span class="bg-blue-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded shadow-lg uppercase tracking-tighter">
              EP {episode}
            </span>
          </div>
        )
      }

      <!-- Progress bar -->
      {
        episode && (
          <div class="absolute bottom-0 left-0 w-full h-1 bg-black/20">
            <div class="h-full bg-blue-600 w-full" />
          </div>
        )
      }
    </div>

    <!-- Info Section (Crunchyroll style: title then type) -->
    <div class="mt-2">
      <h3
        class="text-xs md:text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2rem] md:min-h-[2.5rem] group-hover:text-blue-500 transition-colors"
      >
        {title}
      </h3>
      <p
        class="text-[10px] md:text-xs text-gray-500 dark:text-gray-400 font-medium mt-0.5"
      >
        {type === "TV" ? "Série" : type || "Anime"}
      </p>
    </div>
  </div>
</a>
