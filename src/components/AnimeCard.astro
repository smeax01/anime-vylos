---
import { Play } from "lucide-astro";

interface Props {
  id: number | string;
  image: string;
  title: string;
  type: string;
  episode?: number;
}

const { id, image, title, type, episode } = Astro.props;
---

<a
  href={`/anime/${id}${episode ? `?ep=${episode}` : ""}`}
  class="group block w-full"
>
  <div class="relative flex flex-col h-full">
    <!-- Image with no border on hover, subtle zoom -->
    <div
      class="relative aspect-[2/3] w-full rounded-2xl overflow-hidden bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-800/50 transition-all duration-300"
    >
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
      />

      <!-- Subtle Overlay -->
      <div
        class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
      >
        <div
          class="bg-white/10 backdrop-blur-xl p-4 rounded-full text-white shadow-2xl transform scale-90 group-hover:scale-100 transition-all duration-500"
        >
          <Play size={28} fill="currentColor" />
        </div>
      </div>

      <!-- Episode Badge if available -->
      {
        episode && (
          <div class="absolute top-3 left-3">
            <span class="bg-blue-600 text-white text-[10px] font-black px-2.5 py-1 rounded-lg shadow-xl uppercase tracking-tighter">
              ÉP. {episode}
            </span>
          </div>
        )
      }

      <!-- Progress bar -->
      {
        episode && (
          <div class="absolute bottom-0 left-0 w-full h-1.5 bg-black/20">
            <div class="h-full bg-blue-600 w-full" />
          </div>
        )
      }
    </div>

    <!-- Title & Type -->
    <div class="mt-3 px-1">
      <h3
        class="text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] group-hover:text-blue-500 transition-colors"
      >
        {title}
      </h3>
      <p
        class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-1"
      >
        {type || "Anime"}
      </p>
    </div>
  </div>
</a>
