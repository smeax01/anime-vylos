---
import { Play } from "lucide-astro";

interface Props {
  id: number | string;
  image: string;
  title: string;
  episode?: number;
}

const { id, image, title, episode } = Astro.props;
---

<a
  href={`/anime/${id}${episode ? `?ep=${episode}` : ""}`}
  class="group block w-full"
>
  <div
    class="h-full bg-white dark:bg-gray-950 border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden transition-all duration-300 hover:border-blue-500/50 hover:shadow-xl group-hover:-translate-y-1"
  >
    <!-- Image Card (Embed style) -->
    <div class="relative aspect-[2/3] w-full overflow-hidden">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      />

      <!-- Play Icon Overlay (Center) -->
      <div
        class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      >
        <div
          class="bg-blue-600 p-3 rounded-full text-white shadow-2xl transform scale-75 group-hover:scale-100 transition-transform duration-300"
        >
          <Play size={24} fill="currentColor" />
        </div>
      </div>

      <!-- History Progress bar -->
      {
        episode && (
          <div class="absolute top-0 left-0 w-full h-1 bg-white/20">
            <div class="h-full bg-blue-600" style="width: 100%" />
          </div>
        )
      }
    </div>

    <!-- Info Block (Footer style) -->
    <div
      class="p-3 bg-gray-50/50 dark:bg-gray-900/40 border-t border-gray-100 dark:border-gray-800"
    >
      <h3
        class="text-xs md:text-sm font-black text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] uppercase tracking-tight group-hover:text-blue-500 transition-colors"
      >
        {title}
      </h3>
    </div>
  </div>
</a>
