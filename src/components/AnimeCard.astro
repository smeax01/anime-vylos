---
interface Props {
  id: number | string;
  image: string;
  title: string;
  type: string;
  episode?: number;
}

const { id, image, title, type, episode } = Astro.props;
---

<a
  href={`/anime/${id}${episode ? `?ep=${episode}` : ""}`}
  class="group block w-full"
>
  <div class="relative flex flex-col h-full">
    <!-- Image -->
    <div
      class="relative aspect-[2/3] w-full rounded-md overflow-hidden bg-[#050505] border border-[#1E293B] transition-all duration-300 group-hover:border-[#3B82F6]/50"
    >
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      />

      <!-- Overlay -->
      <div
        class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      >
      </div>

      <!-- Episode Badge -->
      {
        episode && (
          <div class="absolute bottom-2 left-2">
            <span class="bg-[#3B82F6] text-white text-[9px] font-black px-1.5 py-0.5 rounded uppercase tracking-widest shadow-lg">
              EP {episode}
            </span>
          </div>
        )
      }

      <!-- Progress bar -->
      {
        episode && (
          <div class="absolute bottom-0 left-0 w-full h-1 bg-black/60">
            <div class="h-full bg-[#3B82F6] w-full" />
          </div>
        )
      }
    </div>

    <!-- Info Section -->
    <div class="mt-3">
      <h3
        class="text-xs md:text-sm font-bold text-[#E5E7EB] line-clamp-2 leading-tight min-h-[2.5rem] group-hover:text-[#60A5FA] transition-colors duration-300"
      >
        {title}
      </h3>
      <p
        class="text-[10px] md:text-xs text-[#9CA3AF] font-medium mt-1 italic uppercase tracking-wider"
      >
        {type === "TV" ? "Série" : type || "Anime"}
      </p>
    </div>
  </div>
</a>
