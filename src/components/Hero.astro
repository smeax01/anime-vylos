---
import { Play, Info, Star } from "lucide-astro";

interface Props {
  id: number;
  title: string;
  description: string;
  image: string;
  genres: string[];
  rating: number;
}

const { id, title, description, image, genres, rating } = Astro.props;
---

<section
  class="relative h-[85vh] md:h-[75vh] w-full overflow-hidden flex items-end md:items-center"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover object-top"
    />
    <!-- Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 md:via-gray-900/20 to-transparent"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-4 pb-12 md:pb-0">
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 mb-4">
        <span
          class="bg-blue-600 text-white text-xs font-bold px-2.5 py-1 rounded"
          >NOUVEAUTÉ</span
        >
        {
          rating && (
            <span class="bg-gray-800/80 backdrop-blur text-yellow-400 text-xs font-bold px-2.5 py-1 rounded flex items-center gap-1">
              <Star size={12} fill="currentColor" />
              {rating / 10}
            </span>
          )
        }
      </div>

      <h1
        class="text-4xl md:text-6xl font-extrabold text-white mb-4 tracking-tight leading-tight"
      >
        {title}
      </h1>

      <div class="flex flex-wrap gap-2 mb-6 text-sm font-medium text-gray-300">
        {
          genres
            .slice(0, 3)
            .map((g) => (
              <span class="after:content-['•'] last:after:content-[''] after:ml-2">
                {g}
              </span>
            ))
        }
      </div>

      <p
        class="text-gray-300 text-base md:text-lg mb-8 line-clamp-3 max-w-xl"
        set:html={description}
      />

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={`/anime/${id}`}
          class="inline-flex items-center justify-center px-6 py-3 text-base font-bold text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800 transition-colors"
        >
          <Play size={20} fill="currentColor" class="mr-2" />
          Regarder
        </a>
        <a
          href={`/anime/${id}`}
          class="inline-flex items-center justify-center px-6 py-3 text-base font-bold text-center text-white bg-gray-800/60 backdrop-blur rounded-lg border border-gray-100/20 hover:bg-gray-800/80 focus:ring-4 focus:ring-gray-300 focus:outline-none transition-colors"
        >
          <Info size={20} class="mr-2" />
          Plus d'infos
        </a>
      </div>
    </div>
  </div>
</section>
