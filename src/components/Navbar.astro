---
import {
  Home,
  Search,
  Heart,
  User,
  LogOut,
  ChevronDown,
  Bookmark,
} from "lucide-astro";
import Logo from "./Logo.astro";

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  pathname === path || (path !== "/" && pathname.startsWith(path));
---

<nav
  class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 sticky top-0 z-[100]"
>
  <div class="max-w-[1600px] flex items-center h-16 mx-auto px-4 md:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0 mr-10 group">
      <Logo scale={0.7} />
    </a>

    <!-- Main Links -->
    <div
      class="hidden lg:flex items-center space-x-6 text-sm font-bold text-gray-500 dark:text-gray-400"
    >
      <a
        href="/"
        class={`hover:text-blue-600 dark:hover:text-blue-500 transition-colors ${isActive("/") ? "text-blue-600 dark:text-blue-500" : ""}`}
        >Parcourir</a
      >
      <a
        href="/search"
        class="hover:text-blue-600 dark:hover:text-blue-500 transition-colors"
        >Nouveau</a
      >
      <a
        href="/search"
        class="hover:text-blue-600 dark:hover:text-blue-500 transition-colors"
        >Populaire</a
      >
      <a
        href="/search"
        class="hover:text-blue-600 dark:hover:text-blue-500 transition-colors"
        >Simulcast</a
      >
      <div
        class="flex items-center gap-1 cursor-pointer hover:text-blue-600 transition-colors"
      >
        <span>Catégories</span>
        <ChevronDown size={14} />
      </div>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center ml-auto space-x-2 md:space-x-6">
      <!-- Search icon -->
      <a
        href="/search"
        class="p-2 text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors"
      >
        <Search size={22} />
      </a>

      <!-- Favorites -->
      <a
        href="/favorites"
        class="p-2 text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors"
      >
        <Bookmark size={22} />
      </a>

      <!-- User Menu -->
      <div id="user-menu-root" class="relative">
        <button
          type="button"
          class="flex text-sm bg-gray-200 dark:bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-white/10"
          id="user-menu-button"
          aria-expanded="false"
          data-dropdown-toggle="user-dropdown"
        >
          <img
            id="nav-avatar"
            class="w-8 h-8 rounded-full object-cover border border-gray-200 dark:border-gray-700"
            src="/favicon.svg"
            alt="user photo"
          />
        </button>

        <!-- Dropdown -->
        <div
          class="z-50 hidden my-4 text-base list-none bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700 rounded-lg shadow-2xl border border-gray-200 dark:border-gray-700"
          id="user-dropdown"
        >
          <div class="px-4 py-3">
            <span
              id="nav-username"
              class="block text-sm font-bold text-gray-900 dark:text-white"
              >Invité</span
            >
            <span
              id="nav-email"
              class="block text-[10px] text-gray-500 truncate"
              >Connectez-vous pour plus de fonctions</span
            >
          </div>
          <ul class="py-2">
            <li>
              <a
                href="/profile"
                class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                >Mon compte</a
              >
            </li>
            <li>
              <a
                href="/favorites"
                class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                >Mes favoris</a
              >
            </li>
            <li id="logout-item" class="hidden">
              <button
                id="nav-logout"
                class="w-full text-left flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
              >
                <LogOut size={16} />
                Déconnexion
              </button>
            </li>
            <li id="login-item">
              <a
                href="/login"
                class="block px-4 py-2 text-sm text-blue-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                >Connexion</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  function updateNavbar() {
    const sessionStr = localStorage.getItem("yvlos_session");
    const navAvatar = document.getElementById("nav-avatar") as HTMLImageElement;
    const navUsername = document.getElementById("nav-username");
    const navEmail = document.getElementById("nav-email");
    const logoutItem = document.getElementById("logout-item");
    const loginItem = document.getElementById("login-item");

    if (sessionStr) {
      try {
        const user = JSON.parse(sessionStr);
        if (navAvatar && user.avatar) navAvatar.src = user.avatar;
        if (navUsername) navUsername.innerText = user.username || "Utilisateur";
        if (navEmail) navEmail.innerText = user.email || "";
        logoutItem?.classList.remove("hidden");
        loginItem?.classList.add("hidden");
      } catch (e) {
        localStorage.removeItem("yvlos_session");
      }
    }

    document.getElementById("nav-logout")?.addEventListener("click", () => {
      localStorage.removeItem("yvlos_session");
      window.location.reload();
    });
  }

  updateNavbar();
  window.addEventListener("storage", updateNavbar);
</script>
