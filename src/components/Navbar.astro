---
import { Search, ChevronDown, Bookmark, LogOut } from "lucide-astro";
import Logo from "./Logo.astro";

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  pathname === path || (path !== "/" && pathname.startsWith(path));
---

<nav
  class="bg-[#0F172A]/80 backdrop-blur-xl border-b border-[#1E293B] sticky top-0 z-[100]"
>
  <div class="max-w-[1600px] flex items-center h-16 mx-auto px-4 md:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0 mr-10">
      <Logo scale={0.7} />
    </a>

    <!-- Main Links -->
    <div
      class="hidden lg:flex items-center space-x-8 text-sm font-bold text-[#9CA3AF]"
    >
      <a
        href="/"
        class={`hover:text-[#60A5FA] transition-colors ${isActive("/") ? "text-[#3B82F6]" : ""}`}
        >Parcourir</a
      >
      <a href="/search" class="hover:text-[#60A5FA] transition-colors"
        >Nouveau</a
      >
      <a href="/search" class="hover:text-[#60A5FA] transition-colors"
        >Populaire</a
      >
      <a href="/search" class="hover:text-[#60A5FA] transition-colors"
        >Simulcast</a
      >
      <div
        class="flex items-center gap-1 cursor-pointer hover:text-[#60A5FA] transition-colors"
      >
        <span>Catégories</span>
        <ChevronDown size={14} />
      </div>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center ml-auto space-x-2 md:space-x-6">
      <!-- Search icon -->
      <a
        href="/search"
        class="p-2 text-[#9CA3AF] hover:text-[#3B82F6] transition-colors"
      >
        <Search size={22} />
      </a>

      <!-- Favorites -->
      <a
        href="/favorites"
        class="p-2 text-[#9CA3AF] hover:text-[#3B82F6] transition-colors"
      >
        <Bookmark size={22} />
      </a>

      <!-- User Menu -->
      <div id="user-menu-root" class="relative">
        <button
          type="button"
          class="flex text-sm bg-[#1E293B] rounded-full focus:ring-4 focus:ring-[#3B82F6]/20"
          id="user-menu-button"
          aria-expanded="false"
          data-dropdown-toggle="user-dropdown"
        >
          <img
            id="nav-avatar"
            class="w-8 h-8 rounded-full object-cover border border-[#1E293B]"
            src="/favicon.svg"
            alt="user photo"
          />
        </button>

        <!-- Dropdown -->
        <div
          class="z-50 hidden my-4 text-base list-none bg-[#0F172A] divide-y divide-[#1E293B] rounded-xl shadow-2xl border border-[#1E293B]"
          id="user-dropdown"
        >
          <div class="px-4 py-3">
            <span
              id="nav-username"
              class="block text-sm font-bold text-[#E5E7EB]">Invité</span
            >
            <span
              id="nav-email"
              class="block text-[10px] text-[#9CA3AF] truncate"
              >Connectez-vous pour plus de fonctions</span
            >
          </div>
          <ul class="py-2">
            <li>
              <a
                href="/profile"
                class="block px-4 py-2 text-sm text-[#E5E7EB] hover:bg-[#1E293B] hover:text-[#60A5FA] transition-colors"
                >Mon compte</a
              >
            </li>
            <li>
              <a
                href="/favorites"
                class="block px-4 py-2 text-sm text-[#E5E7EB] hover:bg-[#1E293B] hover:text-[#60A5FA] transition-colors"
                >Mes favoris</a
              >
            </li>
            <li id="logout-item" class="hidden">
              <button
                id="nav-logout"
                class="w-full text-left flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-[#1E293B] transition-colors"
              >
                <LogOut size={16} />
                Déconnexion
              </button>
            </li>
            <li id="login-item">
              <a
                href="/login"
                class="block px-4 py-2 text-sm text-[#3B82F6] hover:bg-[#1E293B] transition-colors"
                >Connexion</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  function updateNavbar() {
    const sessionStr = localStorage.getItem("yvlos_session");
    const navAvatar = document.getElementById("nav-avatar") as HTMLImageElement;
    const navUsername = document.getElementById("nav-username");
    const navEmail = document.getElementById("nav-email");
    const logoutItem = document.getElementById("logout-item");
    const loginItem = document.getElementById("login-item");

    if (sessionStr) {
      try {
        const user = JSON.parse(sessionStr);
        if (navAvatar && user.avatar) navAvatar.src = user.avatar;
        if (navUsername) navUsername.innerText = user.username || "Utilisateur";
        if (navEmail) navEmail.innerText = user.email || "";
        logoutItem?.classList.remove("hidden");
        loginItem?.classList.add("hidden");
      } catch (e) {
        localStorage.removeItem("yvlos_session");
      }
    }

    document.getElementById("nav-logout")?.addEventListener("click", () => {
      localStorage.removeItem("yvlos_session");
      window.location.reload();
    });
  }

  updateNavbar();
  window.addEventListener("storage", updateNavbar);
</script>
