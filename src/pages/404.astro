---
import Layout from "../layouts/Layout.astro";
import { Home, ArrowLeft } from "lucide-astro";
---

<Layout title="404 - Introuvable">
  <section
    class="max-w-screen-xl mx-auto px-4 min-h-[80vh] flex flex-col items-center justify-center text-center space-y-8"
  >
    <div class="relative">
      <h1
        class="text-[12rem] md:text-[16rem] font-black text-gray-100 dark:text-gray-900 select-none"
      >
        404
      </h1>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <p
          class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white tracking-tight uppercase"
        >
          Dimension inconnue
        </p>
      </div>
    </div>

    <div class="max-w-md space-y-6">
      <p
        class="text-gray-500 dark:text-gray-400 font-medium text-lg leading-relaxed"
      >
        Oups ! La page que vous recherchez semble s'être égarée. Elle a
        peut-être été supprimée ou n'a jamais existé.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-4 text-white bg-blue-700 hover:bg-blue-800 font-black rounded-2xl transition-all shadow-lg shadow-blue-700/20 gap-2"
        >
          <Home size={20} />
          Retour à l'accueil
        </a>
        <button
          onclick="history.back()"
          class="inline-flex items-center justify-center px-8 py-4 text-gray-700 dark:text-white bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 font-black rounded-2xl transition-all gap-2"
        >
          <ArrowLeft size={20} />
          Page précédente
        </button>
      </div>
    </div>
  </section>
</Layout>
