---
import Layout from "../../layouts/Layout.astro";
import { getAnimeById } from "../../lib/anilist";
import {
  ArrowLeft,
  Tv,
  Info,
  AlertCircle,
  RefreshCw,
  Heart,
  Star,
  Monitor,
  ChevronRight,
  ChevronLeft,
} from "lucide-astro";

export const prerender = false;

const { id } = Astro.params;
const animeId = Number(id);

if (isNaN(animeId)) return Astro.redirect("/404");

let anime = null;
try {
  anime = await getAnimeById(animeId);
} catch (e) {
  console.error("AniList Fetch Error:", e);
}

if (!anime) return Astro.redirect("/404");

const title = anime.title.romaji || anime.title.english;
---

<Layout title={title}>
  <div
    id="anime-data"
    data-id={anime.id}
    data-title={title}
    data-cover={anime.coverImage.extraLarge || anime.coverImage.large}
    data-type={anime.format}
    class="hidden"
  >
  </div>

  <div class="bg-[#050505] min-h-screen text-[#E5E7EB]">
    <!-- Top Navigation (Crunchyroll style) -->
    <div class="max-w-[1600px] mx-auto px-4 py-4">
      <a
        href="/"
        class="inline-flex items-center text-sm font-bold text-[#9CA3AF] hover:text-[#3B82F6] transition-colors gap-2 group"
      >
        <ArrowLeft
          size={18}
          class="transition-transform group-hover:-translate-x-1"
        />
        RETOUR
      </a>
    </div>

    <!-- Player Container -->
    <div class="w-full bg-black relative shadow-2xl">
      <div class="max-w-[1400px] mx-auto">
        <!-- Main Video Player -->
        <div
          class="relative w-full aspect-video md:rounded-xl overflow-hidden bg-black border border-white/5"
        >
          <div
            id="player-loading"
            class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#050505] gap-4"
          >
            <div
              class="animate-spin rounded-full h-10 w-10 border-4 border-[#3B82F6] border-t-transparent"
            >
            </div>
            <p
              id="status-text"
              class="text-xs font-black uppercase tracking-widest text-[#9CA3AF]"
            >
              Recherche en cours...
            </p>
          </div>

          <iframe
            id="content-frame"
            class="w-full h-full border-none relative z-10"
            src="about:blank"
            allowfullscreen
            allow="autoplay; encrypted-media"></iframe>
        </div>

        <!-- Player Mobile Info/Actions -->
        <div
          class="px-4 py-4 flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-white/5"
        >
          <div class="flex items-center gap-4">
            <div
              id="lang-selector"
              class="flex p-1 bg-white/5 rounded-lg border border-white/10"
            >
              <button
                data-lang="vf"
                class="lang-btn px-4 py-1.5 text-xs font-black rounded-md transition-all"
                >VF</button
              >
              <button
                data-lang="vostfr"
                class="lang-btn px-4 py-1.5 text-xs font-black rounded-md transition-all"
                >VOSTFR</button
              >
            </div>
            <div class="h-8 w-px bg-white/5"></div>
            <div class="flex items-center gap-2 text-[#9CA3AF]">
              <Monitor size={16} />
              <span
                id="active-server-name"
                class="text-[10px] font-black uppercase tracking-wider text-[#3B82F6]"
                >Sibnet</span
              >
            </div>
          </div>

          <div class="flex items-center gap-4">
            <button
              id="toggle-favorite"
              class="flex items-center gap-2 text-[#9CA3AF] hover:text-[#3B82F6] transition-colors group"
            >
              <Heart
                id="fav-icon"
                size={20}
                class="group-active:scale-125 transition-transform"
              />
              <span class="text-[10px] font-black uppercase tracking-widest"
                >Ma Liste</span
              >
            </button>
            <button
              id="reload-player"
              class="flex items-center gap-2 text-[#9CA3AF] hover:text-[#3B82F6] transition-colors group"
            >
              <RefreshCw
                size={18}
                class="group-active:rotate-180 transition-transform"
              />
              <span class="text-[10px] font-black uppercase tracking-widest"
                >Refresh</span
              >
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Details Section -->
    <div class="max-w-[1400px] mx-auto px-4 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Episodes & Info -->
        <div class="lg:col-span-8 space-y-12">
          <!-- Title & Header -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span
                class="bg-[#3B82F6] text-white text-[10px] font-black px-2 py-0.5 rounded uppercase"
                >{anime.format}</span
              >
              <span
                class="text-[#9CA3AF] font-bold text-xs uppercase tracking-widest"
                >{anime.status}</span
              >
              {
                anime.averageScore && (
                  <div class="flex items-center gap-1 text-[#60A5FA] font-black text-xs">
                    <Star size={14} fill="currentColor" />
                    {anime.averageScore / 10}
                  </div>
                )
              }
            </div>
            <h1
              class="text-3xl md:text-5xl font-black text-white tracking-tighter uppercase leading-none"
            >
              {title}
            </h1>
          </div>

          <!-- Episode Grid -->
          <div class="space-y-6">
            <div
              class="flex items-center justify-between border-b border-white/5 pb-4"
            >
              <h2
                class="text-lg font-black text-white uppercase tracking-widest flex items-center gap-3"
              >
                <Tv size={20} class="text-[#3B82F6]" />
                Épisodes
                <span
                  id="progress-indicator"
                  class="text-xs text-[#9CA3AF] normal-case font-medium"></span>
              </h2>
            </div>

            <div
              id="ep-list"
              class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 gap-3"
            >
              <!-- JS Injection -->
            </div>

            <div
              id="error-box"
              class="hidden p-6 rounded-xl bg-red-500/10 border border-red-500/20 text-red-500 flex items-center gap-4 text-sm font-bold animate-pulse"
            >
              <AlertCircle size={24} />
              <p>
                Désolé, cet anime n'est pas encore disponible en version <span
                  class="current-lang-error uppercase font-black"></span>.
              </p>
            </div>
          </div>

          <!-- Description -->
          <div class="space-y-4 pt-8 border-t border-white/5">
            <h3
              class="text-xs font-black text-[#9CA3AF] uppercase tracking-[0.2em] flex items-center gap-2"
            >
              <Info size={14} />
              Synopsis
            </h3>
            <p
              class="text-[#E5E7EB] text-sm md:text-base leading-relaxed opacity-80"
              set:html={anime.description}
            />
          </div>
        </div>

        <!-- Sidebar / Related -->
        <div class="lg:col-span-4 space-y-12">
          {
            anime.relations?.edges && anime.relations.edges.length > 0 && (
              <div class="space-y-6">
                <h3 class="text-xs font-black text-[#9CA3AF] uppercase tracking-[0.2em]">
                  Relatif à l'histoire
                </h3>
                <div class="space-y-4">
                  {anime.relations.edges
                    .filter((e: any) => e.node.type === "ANIME")
                    .slice(0, 5)
                    .map((rel: any) => (
                      <a
                        href={`/anime/${rel.node.id}`}
                        class="flex items-center gap-4 group"
                      >
                        <div class="w-16 h-24 rounded-lg overflow-hidden flex-shrink-0 bg-white/5 border border-white/5">
                          <img
                            src={rel.node.coverImage.medium}
                            class="w-full h-full object-cover transition-transform group-hover:scale-110"
                          />
                        </div>
                        <div class="min-w-0">
                          <p class="text-[9px] font-black text-[#3B82F6] uppercase mb-1">
                            {rel.relationType}
                          </p>
                          <p class="text-xs font-bold text-white line-clamp-2 leading-snug group-hover:text-[#60A5FA] transition-colors">
                            {rel.node.title.romaji || rel.node.title.english}
                          </p>
                        </div>
                      </a>
                    ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const dataEl = document.getElementById("anime-data");
  const frame = document.getElementById("content-frame") as HTMLIFrameElement;
  const loader = document.getElementById("player-loading");
  const statusText = document.getElementById("status-text");
  const epList = document.getElementById("ep-list");
  const errorBox = document.getElementById("error-box");
  const favIcon = document.getElementById("fav-icon");
  const langBtns = document.querySelectorAll(".lang-btn");
  const progressBadge = document.getElementById("progress-indicator");

  const animeId = dataEl?.dataset.id || "";
  const animeTitle = dataEl?.dataset.title || "";
  const animeCover = dataEl?.dataset.cover || "";
  const animeType = dataEl?.dataset.type || "";

  let currentSources: any = {};
  let currentEp = 1;
  let activeLang = "vostfr";

  function getProgress() {
    return JSON.parse(
      localStorage.getItem(`yvlos_progress_${animeId}`) ||
        '{"lastEp":1,"history":[]}',
    );
  }

  async function saveProgress(ep: number) {
    const progress = getProgress();
    if (!progress.history.includes(ep)) progress.history.push(ep);
    progress.lastEp = ep;
    localStorage.setItem(`yvlos_progress_${animeId}`, JSON.stringify(progress));

    // Global History
    const history = JSON.parse(
      localStorage.getItem("yvlos_global_history") || "[]",
    );
    const info = {
      id: animeId,
      title: animeTitle,
      image: animeCover,
      type: animeType,
      lastEp: ep,
      updatedAt: Date.now(),
    };
    const filtered = history.filter((a: any) => a.id !== animeId);
    filtered.unshift(info);
    localStorage.setItem(
      "yvlos_global_history",
      JSON.stringify(filtered.slice(0, 20)),
    );

    updateUI();
  }

  async function switchLang(lang: string) {
    activeLang = lang;
    langBtns.forEach((b) => {
      const active = b.getAttribute("data-lang") === lang;
      b.className = `lang-btn px-4 py-1.5 text-xs font-black rounded-md transition-all ${active ? "bg-[#3B82F6] text-white" : "text-[#9CA3AF] hover:text-white"}`;
    });

    if (loader) loader.style.display = "flex";
    errorBox?.classList.add("hidden");

    try {
      const slugs = [
        animeTitle
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, ""),
        animeTitle
          .split(" ")
          .slice(0, 2)
          .join("-")
          .toLowerCase()
          .replace(/[^a-z0-9]/g, "-"), // Short version
        animeTitle
          .toLowerCase()
          .replace(/season \d+/, "")
          .trim()
          .replace(/[^a-z0-9]/g, "-")
          .replace(/-+/g, "-"), // No season
      ];

      let found = false;
      for (const slug of [...new Set(slugs)]) {
        const res = await fetch(`/api/as-source?slug=${slug}&lang=${lang}`);
        if (res.ok) {
          const data = await res.json();
          currentSources = data.sources;
          found = true;
          break;
        }
      }

      if (found) {
        renderEpisodes();
        loadVideo(currentEp);
      } else {
        throw new Error("No source found");
      }
    } catch (e) {
      if (loader) loader.style.display = "none";
      errorBox?.classList.remove("hidden");
      const langSpan = document.querySelector(".current-lang-error");
      if (langSpan) langSpan.textContent = lang;
    }
  }

  function renderEpisodes() {
    if (!epList) return;
    epList.innerHTML = "";
    const server = Object.keys(currentSources)[0];
    const episodes = currentSources[server] || [];

    episodes.forEach((_: any, i: number) => {
      const num = i + 1;
      const btn = document.createElement("button");
      const isSeen = getProgress().history.includes(num);
      btn.className = `p-2 text-xs font-black rounded-lg transition-all border aspect-square flex items-center justify-center ${num === currentEp ? "bg-[#3B82F6] text-white border-[#3B82F6]" : isSeen ? "bg-white/5 text-[#9CA3AF] border-white/10" : "bg-white/5 text-white border-white/10 hover:border-[#3B82F6]"}`;
      btn.innerText = num.toString();
      btn.onclick = () => loadVideo(num);
      epList.appendChild(btn);
    });
  }

  function loadVideo(num: number) {
    currentEp = num;
    const server = currentSources.eps3
      ? "eps3"
      : Object.keys(currentSources)[0];
    const url = (currentSources[server] || [])[num - 1];

    if (url) {
      frame.src = url;
      saveProgress(num);
      renderEpisodes();
      setTimeout(() => {
        if (loader) loader.style.display = "none";
      }, 1000);
    }
  }

  function updateUI() {
    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );
    if (favorites.some((f: any) => f.id === animeId))
      favIcon?.classList.add("fill-[#3B82F6]", "text-[#3B82F6]");
    else favIcon?.classList.remove("fill-[#3B82F6]", "text-[#3B82F6]");

    const progress = getProgress();
    if (progressBadge)
      progressBadge.innerText = `(${progress.history.length} vus)`;
  }

  document.getElementById("toggle-favorite")?.addEventListener("click", () => {
    let favorites = JSON.parse(localStorage.getItem("yvlos_favorites") || "[]");
    const index = favorites.findIndex((f: any) => f.id === animeId);
    if (index > -1) favorites.splice(index, 1);
    else
      favorites.push({
        id: animeId,
        title: animeTitle,
        image: animeCover,
        type: animeType,
      });
    localStorage.setItem("yvlos_favorites", JSON.stringify(favorites));
    updateUI();
  });

  document.querySelectorAll(".lang-btn").forEach((btn) => {
    btn.addEventListener("click", () =>
      switchLang((btn as HTMLElement).dataset.lang || "vostfr"),
    );
  });

  document.getElementById("reload-player")!.onclick = () =>
    loadVideo(currentEp);

  const params = new URLSearchParams(window.location.search);
  currentEp = Number(params.get("ep")) || getProgress().lastEp || 1;
  switchLang(params.get("lang") || "vostfr");
  updateUI();
</script>
