---
import Layout from "../../layouts/Layout.astro";
import { getAnimeById } from "../../lib/anilist";
import {
  ArrowLeft,
  Play,
  Tv,
  Info,
  AlertCircle,
  RefreshCw,
  Heart,
  Star,
  Globe,
  Monitor,
} from "lucide-astro";

export const prerender = false;

const { id } = Astro.params;
const animeId = Number(id);

if (isNaN(animeId)) return Astro.redirect("/404");

let anime = null;
try {
  anime = await getAnimeById(animeId);
} catch (e) {
  console.error("AniList Fetch Error:", e);
}

if (!anime) return Astro.redirect("/404");

const title = anime.title.romaji || anime.title.english;
---

<Layout title={title}>
  <!-- Server-side data for JS -->
  <div
    id="anime-data"
    data-id={anime.id}
    data-title={title}
    data-cover={anime.coverImage.large}
    data-type={`${anime.format || "TV"} • ${anime.genres[0] || "Anime"}`}
    data-eps={anime.episodes || 0}
    class="hidden"
  >
  </div>

  <div class="bg-gray-50 dark:bg-gray-950 min-h-screen">
    <!-- Player Section -->
    <div class="bg-black relative pt-4 pb-4 md:pt-10 md:pb-10 shadow-lg">
      <div class="max-w-screen-xl mx-auto px-4">
        <!-- Breadcrumbs / Top Nav -->
        <div class="flex items-center justify-between mb-4 md:mb-6">
          <a
            href="/"
            class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-white transition-colors"
          >
            <ArrowLeft size={18} class="mr-2" />
            Retour à l'accueil
          </a>
          <div class="hidden md:flex items-center gap-4">
            <button
              id="toggle-favorite"
              class="flex items-center gap-2 text-gray-400 hover:text-pink-500 transition-colors"
            >
              <Heart id="fav-icon" size={20} />
              <span class="text-xs font-bold uppercase tracking-wider"
                >Favoris</span
              >
            </button>
            <button
              id="reload-player"
              class="flex items-center gap-2 text-gray-400 hover:text-blue-500 transition-colors"
            >
              <RefreshCw size={18} />
              <span class="text-xs font-bold uppercase tracking-wider"
                >Rafraîchir</span
              >
            </button>
          </div>
        </div>

        <!-- Main Player -->
        <div
          class="relative w-full aspect-video rounded-2xl overflow-hidden bg-gray-900 border border-gray-800 shadow-2xl"
        >
          <div
            id="player-loading"
            class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-gray-900 gap-4"
          >
            <div
              class="animate-spin rounded-full h-12 w-12 border-4 border-blue-600 border-t-transparent"
            >
            </div>
            <p id="status-text" class="text-gray-400 font-medium">
              Recherche sur les serveurs...
            </p>
          </div>

          <iframe
            id="content-frame"
            class="w-full h-full border-none"
            src="about:blank"
            allowfullscreen
            allow="autoplay; encrypted-media"></iframe>
        </div>

        <!-- Player Controls (Mobile First) -->
        <div
          class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <div class="flex items-center gap-4 w-full sm:w-auto">
            <div
              class="inline-flex rounded-xl shadow-sm bg-gray-800 p-1"
              role="group"
            >
              <button
                type="button"
                data-lang="vf"
                class="lang-btn px-4 py-2 text-xs font-bold rounded-lg transition-all text-gray-400 hover:text-white"
              >
                VF
              </button>
              <button
                type="button"
                data-lang="vostfr"
                class="lang-btn px-4 py-2 text-xs font-bold rounded-lg transition-all text-gray-400 hover:text-white"
              >
                VOSTFR
              </button>
            </div>

            <div class="flex items-center gap-2 text-gray-400">
              <Monitor size={16} />
              <span class="text-xs font-bold uppercase tracking-wider"
                >Lecteur:</span
              >
              <span
                class="text-xs font-bold text-blue-500 uppercase tracking-wider"
                >Sibnet</span
              >
            </div>
          </div>

          <div
            class="flex items-center gap-3 w-full sm:w-auto overflow-x-auto scrollbar-hide"
          >
            <div
              id="mini-ep-display"
              class="bg-blue-600 px-3 py-1.5 rounded-lg text-white text-[10px] font-black uppercase tracking-widest whitespace-nowrap"
            >
              Chargement des épisodes...
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Info Section -->
    <div class="max-w-screen-xl mx-auto px-4 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-10">
          <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-500 text-xs font-bold px-2.5 py-1 rounded-lg border border-blue-600/20"
                >{anime.status}</span
              >
              {
                anime.averageScore && (
                  <span class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-500 text-xs font-bold px-2.5 py-1 rounded-lg border border-yellow-600/20 flex items-center gap-1">
                    <Star size={12} fill="currentColor" />
                    {anime.averageScore / 10}
                  </span>
                )
              }
              <span
                class="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs font-bold px-2.5 py-1 rounded-lg border border-gray-700/20"
                >{anime.format}</span
              >
            </div>
            <h1
              class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tight leading-tight"
            >
              {title}
            </h1>
          </div>

          <!-- Episodes -->
          <div
            class="bg-white dark:bg-gray-900 rounded-3xl p-6 md:p-8 border border-gray-200 dark:border-gray-800 shadow-sm space-y-6"
          >
            <div
              class="flex items-center justify-between border-b dark:border-gray-800 pb-4"
            >
              <h2
                class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2"
              >
                <Tv size={24} class="text-blue-600" />
                Épisodes <span
                  id="progress-indicator"
                  class="text-sm font-medium text-gray-500 ml-2"></span>
              </h2>
            </div>

            <div
              id="ep-list"
              class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 gap-3"
            >
              <!-- Épisodes injectés via JS -->
            </div>

            <div
              id="error-box"
              class="hidden p-4 rounded-2xl bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-500 flex items-center gap-3 text-sm"
            >
              <AlertCircle size={20} />
              <p class="font-medium">
                Désolé, cette version n'est pas encore disponible pour cet anime
                sur nos serveurs.
              </p>
            </div>
          </div>

          <!-- Synopsis Mobile -->
          <div class="lg:hidden space-y-4">
            <h3
              class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2"
            >
              <Info size={20} class="text-blue-500" />
              Synopsis
            </h3>
            <p
              class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm"
              set:html={anime.description}
            />
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-10">
          <!-- Synopsis Desktop -->
          <div class="hidden lg:block space-y-4">
            <h3
              class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2 uppercase tracking-wider text-sm"
            >
              Synopsis
            </h3>
            <p
              class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm"
              set:html={anime.description}
            />
          </div>

          <!-- Relations -->
          {
            anime.relations?.edges && anime.relations.edges.length > 0 && (
              <div class="space-y-6">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white uppercase tracking-wider text-sm">
                  Relatif à l'histoire
                </h3>
                <div class="space-y-4">
                  {anime.relations.edges
                    .filter((e: any) => e.node.type === "ANIME")
                    .slice(0, 5)
                    .map((rel: any) => (
                      <a
                        href={`/anime/${rel.node.id}`}
                        class="flex items-center gap-4 group"
                      >
                        <div class="w-16 h-20 rounded-xl overflow-hidden flex-shrink-0 bg-gray-200 dark:bg-gray-800">
                          <img
                            src={rel.node.coverImage.medium}
                            alt=""
                            class="w-full h-full object-cover transition-transform group-hover:scale-110"
                          />
                        </div>
                        <div class="min-w-0">
                          <p class="text-[10px] font-bold text-blue-500 uppercase tracking-widest mb-1">
                            {rel.relationType}
                          </p>
                          <p class="text-sm font-bold text-gray-900 dark:text-white line-clamp-2 leading-snug group-hover:text-blue-600 transition-colors">
                            {rel.node.title.romaji || rel.node.title.english}
                          </p>
                        </div>
                      </a>
                    ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const dataEl = document.getElementById("anime-data");
  const frame = document.getElementById("content-frame") as HTMLIFrameElement;
  const loader = document.getElementById("player-loading");
  const statusText = document.getElementById("status-text");
  const epList = document.getElementById("ep-list");
  const miniEp = document.getElementById("mini-ep-display");
  const errorBox = document.getElementById("error-box");
  const favBtn = document.getElementById("toggle-favorite");
  const favIcon = document.getElementById("fav-icon");
  const langBtns = document.querySelectorAll(".lang-btn");
  const progressBadge = document.getElementById("progress-indicator");

  const animeId = dataEl?.dataset.id || "";
  const animeTitle = dataEl?.dataset.title || "";
  const animeCover = dataEl?.dataset.cover || "";
  const animeType = dataEl?.dataset.type || "";

  let currentSources: any = {};
  let currentEp = 1;
  let activeServer = "eps3"; // Default: Sibnet
  let activeLang = "vf"; // Default: VF

  function getProgress() {
    const data = localStorage.getItem(`yvlos_progress_${animeId}`);
    return data ? JSON.parse(data) : { lastEp: 1, history: [] };
  }

  async function saveProgress(ep: number) {
    const progress = getProgress();
    const isNewEpisode = !progress.history.includes(ep);

    progress.lastEp = ep;
    if (isNewEpisode) progress.history.push(ep);
    localStorage.setItem(`yvlos_progress_${animeId}`, JSON.stringify(progress));

    const globalHistory = JSON.parse(
      localStorage.getItem("yvlos_global_history") || "[]",
    );
    const existingIndex = globalHistory.findIndex(
      (a: any) => a.id === animeId.toString(),
    );
    const animeEntry = {
      id: animeId.toString(),
      title: animeTitle,
      image: animeCover,
      type: animeType,
      lastEp: ep,
      updatedAt: Date.now(),
    };

    if (existingIndex > -1) globalHistory.splice(existingIndex, 1);
    globalHistory.unshift(animeEntry);
    localStorage.setItem(
      "yvlos_global_history",
      JSON.stringify(globalHistory.slice(0, 20)),
    );

    const sessionStr = localStorage.getItem("yvlos_session");
    if (sessionStr) {
      const user = JSON.parse(sessionStr);
      fetch("/api/sync", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "sync-history",
          userId: user.id,
          animeId: animeId.toString(),
          lastEp: ep,
          progressJson: JSON.stringify(progress),
        }),
      }).catch((e) => console.error("History sync failed", e));

      if (isNewEpisode) {
        user.stats.episodesSeen += 1;
        localStorage.setItem("yvlos_session", JSON.stringify(user));
        fetch("/api/auth", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "update-stats",
            userId: user.id,
            episodesSeen: user.stats.episodesSeen,
          }),
        }).catch((e) => console.error("Stats update failed", e));
      }
    }
    updateUIProgress();
  }

  function toggleFavorite() {
    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );
    const index = favorites.findIndex(
      (fav: any) => fav.id === animeId.toString(),
    );
    const sessionStr = localStorage.getItem("yvlos_session");
    const user = sessionStr ? JSON.parse(sessionStr) : null;
    let isFavorite = false;

    if (index > -1) {
      favorites.splice(index, 1);
      favIcon?.classList.remove("fill-pink-500", "text-pink-500");
    } else {
      isFavorite = true;
      favorites.push({
        id: animeId.toString(),
        title: animeTitle,
        image: animeCover,
        type: animeType,
      });
      favIcon?.classList.add("fill-pink-500", "text-pink-500");
    }
    localStorage.setItem("yvlos_favorites", JSON.stringify(favorites));

    if (user) {
      fetch("/api/sync", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "sync-favorite",
          userId: user.id,
          isFavorite,
          animeId: animeId.toString(),
          title: animeTitle,
          image: animeCover,
          type: animeType,
        }),
      }).catch((e) => console.error("Favorite sync failed", e));
    }
  }

  function updateUIProgress() {
    const progress = getProgress();
    document.querySelectorAll(".ep-chip").forEach((chip: any) => {
      const epNum = parseInt(chip.dataset.num);
      if (progress.history.includes(epNum)) {
        chip.classList.add("bg-gray-200", "dark:bg-gray-800", "text-gray-400");
      }
    });
    if (progressBadge)
      progressBadge.innerText = `(${progress.history.length} vus)`;
  }

  function checkFavorite() {
    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );
    if (favorites.some((fav: any) => fav.id === animeId.toString())) {
      favIcon?.classList.add("fill-pink-500", "text-pink-500");
    }
  }

  function getSlugs(title: string) {
    return [
      title
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, ""),
    ];
  }

  async function switchLang(lang: string) {
    activeLang = lang;
    langBtns.forEach((b) => {
      const isActive = b.getAttribute("data-lang") === lang;
      b.classList.toggle("bg-blue-600", isActive);
      b.classList.toggle("text-white", isActive);
      b.classList.toggle("text-gray-400", !isActive);
    });

    statusText!.innerText = `Chargement en ${lang.toUpperCase()}...`;
    if (loader) loader.style.display = "flex";
    errorBox?.classList.add("hidden");

    const sources = await searchAnimeSama(lang);

    if (sources) {
      currentSources = sources;
      const lastServer = getProgress().server || "eps3";
      activeServer = currentSources[lastServer]
        ? lastServer
        : Object.keys(currentSources)[0];

      renderEpisodes();
      loadVideo(currentEp);
    } else {
      if (loader) loader.style.display = "none";
      errorBox?.classList.remove("hidden");
    }
  }

  async function searchAnimeSama(lang: string) {
    const slugs = getSlugs(animeTitle);
    for (const slug of slugs) {
      try {
        const res = await fetch(`/api/as-source?slug=${slug}&lang=${lang}`);
        if (!res.ok) continue;
        const data = await res.json();
        if (data.sources && Object.keys(data.sources).length > 0)
          return data.sources;
      } catch (e) {}
    }
    return null;
  }

  function renderEpisodes() {
    if (!epList) return;
    epList.innerHTML = "";
    const episodes = currentSources[activeServer] || [];
    episodes.forEach((_: any, index: number) => {
      const num = index + 1;
      const btn = document.createElement("button");
      btn.className = `ep-chip p-2 text-sm font-bold rounded-xl transition-all border border-gray-200 dark:border-gray-800 hover:border-blue-500 hover:text-blue-500 flex items-center justify-center aspect-square ${num === currentEp ? "bg-blue-600 text-white border-blue-600" : "text-gray-700 dark:text-gray-300"}`;
      btn.innerText = num.toString();
      btn.dataset.num = num.toString();
      btn.onclick = () => loadVideo(num);
      epList.appendChild(btn);
    });
    updateUIProgress();
  }

  function loadVideo(num: number) {
    if (!currentEp) return;
    currentEp = num;
    if (miniEp)
      miniEp.innerText = `${activeLang.toUpperCase()} • ÉPISODE ${num}`;
    if (loader) loader.style.display = "flex";

    const episodes = currentSources[activeServer] || [];
    const url = episodes[num - 1];

    if (url) {
      frame.src = url;
      saveProgress(num);
      document.querySelectorAll(".ep-chip").forEach((c) => {
        const n = parseInt((c as HTMLElement).dataset.num || "0");
        c.classList.remove("bg-blue-600", "text-white", "border-blue-600");
        if (n === num)
          c.classList.add("bg-blue-600", "text-white", "border-blue-600");
      });
      setTimeout(() => {
        if (loader) loader.style.display = "none";
      }, 1500);
    } else {
      if (loader) loader.style.display = "none";
      errorBox?.classList.remove("hidden");
    }
  }

  async function init() {
    checkFavorite();
    const params = new URLSearchParams(window.location.search);
    const saved = getProgress();
    currentEp = Number(params.get("ep")) || saved.lastEp || 1;
    const startLang = params.get("lang") || saved.lang || "vostfr";
    await switchLang(startLang);
  }

  favBtn?.addEventListener("click", toggleFavorite);
  langBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const lang = btn.getAttribute("data-lang");
      if (lang && lang !== activeLang) switchLang(lang);
    });
  });

  document.getElementById("reload-player")!.onclick = () =>
    loadVideo(currentEp);

  init();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
