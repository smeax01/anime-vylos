---
import Layout from "../layouts/Layout.astro";
import { Heart, ArrowRight } from "lucide-astro";

export const prerender = true;
---

<Layout title="Mes Favoris">
  <div class="max-w-screen-xl mx-auto px-4 py-8 mt-4 md:mt-8 space-y-12">
    <!-- Header -->
    <div class="space-y-2">
      <h1
        class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white tracking-tight"
      >
        Mes Favoris
      </h1>
      <p class="text-sm md:text-base text-gray-500 font-medium">
        Votre collection personnelle d'animes incontournables sur Yvlos.
      </p>
    </div>

    <!-- Layout Grid -->
    <div
      id="favorites-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6"
    >
      <!-- Injected by JS -->
      <div id="loading" class="col-span-full py-20 text-center">
        <div
          class="animate-spin rounded-full h-10 w-10 border-4 border-blue-600 border-t-transparent mx-auto"
        >
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div
      id="empty-favorites"
      class="hidden py-32 text-center max-w-md mx-auto space-y-6"
    >
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gray-50 dark:bg-gray-900 rounded-2xl text-gray-300 dark:text-gray-700"
      >
        <Heart size={40} />
      </div>
      <div class="space-y-2">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">
          Votre liste est vide
        </h2>
        <p class="text-gray-500 dark:text-gray-400 font-medium text-sm">
          Parcourez le catalogue pour ajouter vos animes préférés.
        </p>
      </div>
      <a
        href="/search"
        class="inline-flex items-center justify-center px-6 py-3 text-white bg-blue-700 hover:bg-blue-800 font-bold rounded-xl transition-all gap-2 group shadow-lg shadow-blue-700/20 active:scale-95"
      >
        Découvrir des animes
        <ArrowRight
          size={18}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</Layout>

<script>
  function renderFavorites() {
    const grid = document.getElementById("favorites-grid");
    const emptyState = document.getElementById("empty-favorites");
    const loading = document.getElementById("loading");

    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );

    if (loading) loading.classList.add("hidden");

    if (favorites.length === 0) {
      grid?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
      return;
    }

    if (grid) {
      grid.classList.remove("hidden");
      grid.innerHTML = favorites
        .map(
          (anime: any) => `
        <a href="/anime/${anime.id}" class="group block w-full">
            <div class="relative aspect-[2/3] w-full rounded-md overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img src="${anime.image}" alt="${anime.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
            </div>
            <div class="mt-2">
                <h3 class="text-xs md:text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2rem] md:min-h-[2.5rem] group-hover:text-blue-500 transition-colors">${anime.title}</h3>
                <p class="text-[10px] md:text-xs text-gray-500 font-medium mt-0.5">${anime.type === "TV" ? "Série" : anime.type || "Anime"}</p>
            </div>
        </a>
      `,
        )
        .join("");
    }
  }

  renderFavorites();
</script>
