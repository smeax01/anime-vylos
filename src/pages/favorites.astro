---
import Layout from "../layouts/Layout.astro";
import { Heart, ArrowRight, Bookmark } from "lucide-astro";

export const prerender = true;
---

<Layout title="Mes Favoris">
  <div
    class="max-w-[1600px] mx-auto px-4 md:px-8 py-12 md:py-16 space-y-12 min-h-screen"
  >
    <!-- Header -->
    <div class="space-y-3">
      <h1
        class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white tracking-tight flex items-center gap-4"
      >
        <Bookmark class="text-blue-600" size={40} fill="currentColor" />
        MES FAVORIS
      </h1>
      <p class="text-sm md:text-lg text-gray-500 font-medium max-w-2xl">
        Retrouvez tous les animés que vous avez enregistrés pour plus tard.
      </p>
    </div>

    <!-- Layout Grid -->
    <div
      id="favorites-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8"
    >
      <!-- Injected by JS -->
      <div id="loading" class="col-span-full py-32 text-center">
        <div
          class="animate-spin rounded-full h-12 w-12 border-4 border-blue-600 border-t-transparent mx-auto"
        >
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div
      id="empty-favorites"
      class="hidden py-32 text-center max-w-md mx-auto space-y-10"
    >
      <div
        class="inline-flex items-center justify-center w-28 h-28 bg-gray-50 dark:bg-gray-800 rounded-[3rem] text-gray-300 dark:text-gray-700 shadow-inner"
      >
        <Bookmark size={56} />
      </div>
      <div class="space-y-3">
        <h2
          class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-tight"
        >
          C'est bien vide ici...
        </h2>
        <p class="text-gray-500 font-medium">
          Parcourez le catalogue pour ajouter vos animes préférés.
        </p>
      </div>
      <a
        href="/search"
        class="inline-flex items-center justify-center px-10 py-4 text-white bg-blue-700 hover:bg-blue-800 font-black rounded-xl transition-all gap-3 group active:scale-95 shadow-xl shadow-blue-500/20"
      >
        Explorer le catalogue
        <ArrowRight
          size={22}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</Layout>

<script>
  function renderFavorites() {
    const grid = document.getElementById("favorites-grid");
    const emptyState = document.getElementById("empty-favorites");
    const loading = document.getElementById("loading");

    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );

    if (loading) loading.classList.add("hidden");

    if (favorites.length === 0) {
      grid?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
      return;
    }

    if (grid) {
      grid.classList.remove("hidden");
      grid.innerHTML = favorites
        .map(
          (anime: any) => `
        <a href="/anime/${anime.id}" class="group block w-full">
            <div class="relative aspect-[2/3] w-full rounded-md overflow-hidden bg-gray-50 dark:bg-gray-800 shadow-sm border border-gray-100 dark:border-gray-800">
                <img src="${anime.image}" alt="${anime.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                <div class="absolute top-3 right-3 p-2 bg-blue-600 text-white rounded shadow-xl">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </div>
            </div>
            <div class="mt-2">
                <h3 class="text-xs md:text-sm font-bold text-gray-900 dark:text-white line-clamp-2 leading-tight min-h-[2rem] md:min-h-[2.5rem] group-hover:text-blue-600 transition-colors">${anime.title}</h3>
                <p class="text-[10px] md:text-xs text-gray-500 font-bold uppercase tracking-widest mt-1">${anime.type === "TV" ? "Série" : anime.type || "Anime"}</p>
            </div>
        </a>
      `,
        )
        .join("");
    }
  }

  renderFavorites();
</script>
