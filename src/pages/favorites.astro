---
import Layout from "../layouts/Layout.astro";
import { Heart, ArrowRight } from "lucide-astro";

export const prerender = true;
---

<Layout title="Mes Favoris">
  <div class="max-w-screen-xl mx-auto px-4 py-12 md:py-20 space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <h1
        class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white flex items-center gap-3 tracking-tight"
      >
        <Heart class="text-pink-600" size={40} fill="currentColor" />
        Mes Favoris
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 font-medium max-w-2xl">
        Retrouvez ici tous les animés que vous avez marqués d'un cœur. Votre
        playlist personnelle sur Yvlos.
      </p>
    </div>

    <!-- Layout Grid -->
    <div
      id="favorites-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6"
    >
      <!-- Injected by JS -->
      <div id="loading" class="col-span-full py-20 text-center">
        <div
          class="animate-spin rounded-full h-12 w-12 border-4 border-blue-600 border-t-transparent mx-auto"
        >
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div
      id="empty-favorites"
      class="hidden py-24 text-center max-w-md mx-auto space-y-8"
    >
      <div
        class="inline-flex items-center justify-center w-24 h-24 bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-500 rounded-3xl"
      >
        <Heart size={48} />
      </div>
      <div class="space-y-2">
        <h2 class="text-2xl font-black text-gray-900 dark:text-white">
          Votre liste est vide
        </h2>
        <p class="text-gray-500 dark:text-gray-400 font-medium">
          Parcourez le catalogue et ajoutez vos coups de cœur pour les retrouver
          facilement.
        </p>
      </div>
      <a
        href="/search"
        class="inline-flex items-center justify-center px-6 py-4 text-white bg-blue-700 hover:bg-blue-800 font-black rounded-2xl transition-all gap-2 group shadow-lg"
      >
        Explorer le catalogue
        <ArrowRight
          size={20}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</Layout>

<script>
  function renderFavorites() {
    const grid = document.getElementById("favorites-grid");
    const emptyState = document.getElementById("empty-favorites");
    const loading = document.getElementById("loading");

    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );

    if (loading) loading.classList.add("hidden");

    if (favorites.length === 0) {
      grid?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
      return;
    }

    if (grid) {
      grid.classList.remove("hidden");
      grid.innerHTML = favorites
        .map(
          (anime: any) => `
        <a href="/anime/${anime.id}" class="group block w-full aspect-[2/3]">
            <div class="relative h-full w-full rounded-2xl overflow-hidden shadow-md border border-gray-100 dark:border-gray-800 transition-all duration-300 group-hover:border-blue-500/50 bg-white dark:bg-gray-950">
                <img src="${anime.image}" alt="${anime.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-70"></div>
                <div class="absolute bottom-0 left-0 w-full p-4">
                    <h3 class="text-xs md:text-sm font-black text-white line-clamp-2 uppercase tracking-tight">${anime.title}</h3>
                </div>
            </div>
        </a>
      `,
        )
        .join("");
    }
  }

  renderFavorites();
</script>
