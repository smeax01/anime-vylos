---
import Layout from "../layouts/Layout.astro";
import { Heart, ArrowRight } from "lucide-astro";

export const prerender = true;
---

<Layout title="Mes Favoris">
  <div class="max-w-screen-xl mx-auto px-4 py-16 md:py-24 space-y-16">
    <!-- Header -->
    <div class="space-y-4 text-center md:text-left">
      <h1
        class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white flex flex-col md:flex-row items-center gap-4 tracking-tighter uppercase"
      >
        <div
          class="w-16 h-16 bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-500 rounded-3xl flex items-center justify-center shadow-lg"
        >
          <Heart size={40} fill="currentColor" />
        </div>
        Mes Favoris
      </h1>
      <p
        class="text-xl text-gray-500 dark:text-gray-400 font-medium max-w-2xl mx-auto md:mx-0"
      >
        Votre collection personnelle d'animes incontournables sur Yvlos.
      </p>
    </div>

    <!-- Layout Grid -->
    <div
      id="favorites-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8"
    >
      <!-- Injected by JS -->
      <div id="loading" class="col-span-full py-32 text-center">
        <div
          class="animate-spin rounded-full h-12 w-12 border-4 border-blue-600 border-t-transparent mx-auto"
        >
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div
      id="empty-favorites"
      class="hidden py-32 text-center max-w-md mx-auto space-y-10"
    >
      <div
        class="inline-flex items-center justify-center w-28 h-28 bg-gray-50 dark:bg-gray-900 rounded-[3rem] text-gray-200 dark:text-gray-800 shadow-inner"
      >
        <Heart size={56} />
      </div>
      <div class="space-y-3">
        <h2
          class="text-3xl font-black text-gray-900 dark:text-white uppercase tracking-tight"
        >
          C'est bien vide ici...
        </h2>
        <p class="text-lg text-gray-500 dark:text-gray-400 font-medium">
          Parcourez le catalogue pour ajouter vos animes préférés à cette liste.
        </p>
      </div>
      <a
        href="/search"
        class="inline-flex items-center justify-center px-10 py-5 text-white bg-blue-700 hover:bg-blue-800 font-black rounded-3xl transition-all gap-3 group shadow-2xl shadow-blue-700/20 active:scale-95"
      >
        Découvrir des animes
        <ArrowRight
          size={24}
          class="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</Layout>

<script>
  function renderFavorites() {
    const grid = document.getElementById("favorites-grid");
    const emptyState = document.getElementById("empty-favorites");
    const loading = document.getElementById("loading");

    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );

    if (loading) loading.classList.add("hidden");

    if (favorites.length === 0) {
      grid?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
      return;
    }

    if (grid) {
      grid.classList.remove("hidden");
      grid.innerHTML = favorites
        .map(
          (anime: any) => `
        <a href="/anime/${anime.id}" class="group block w-full">
            <div class="relative aspect-[2/3] w-full rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-800/50 transition-colors bg-white dark:bg-gray-950">
                <img src="${anime.image}" alt="${anime.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105" />
                <div class="absolute top-3 right-3 p-2 bg-pink-600 text-white rounded-xl shadow-2xl transform scale-0 group-hover:scale-100 transition-transform duration-300">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </div>
            </div>
            <div class="mt-3 px-1">
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] transition-colors">${anime.title}</h3>
                <p class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-1">${anime.type || "Anime"}</p>
            </div>
        </a>
      `,
        )
        .join("");
    }
  }

  renderFavorites();
</script>
