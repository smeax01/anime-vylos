---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AnimeCard from "../components/AnimeCard.astro";
import {
  getPopularAnime,
  getTrendingAnime,
  getLatestAnime,
  getAnimeListByIds,
} from "../lib/anilist";
import libraryData from "../data/library.json";
import { ChevronLeft, ChevronRight } from "lucide-astro";

export const prerender = false;

let popular: any[] = [];
let simulcasts: any[] = [];
let latest: any[] = [];
let error: string | null = null;

try {
  const libraryIds = libraryData.featured.map((a) => a.id);
  const [popData, simData, latData, libData] = await Promise.all([
    getPopularAnime(25),
    getTrendingAnime(25),
    getLatestAnime(25),
    getAnimeListByIds(libraryIds),
  ]);

  const clean = (list: any[]) =>
    list.filter(
      (a) =>
        a &&
        a.id &&
        a.coverImage?.large &&
        !a.isAdult &&
        !a.genres?.some((g: string) =>
          ["Hentai", "Ecchi", "Erotica", "Yaoi", "Yuri"].includes(g),
        ),
    );

  popular = clean(libData);
  simulcasts = clean(simData);
  latest = clean(latData);
} catch (e) {
  console.error("Failed to fetch AniList data:", e);
  error = "Une erreur est survenue...";
}

const heroItems = popular.slice(0, 6).map((a) => ({
  id: a.id,
  title: a.title.romaji || a.title.english,
  description: a.description || "Découvrez cet anime sur Yvlos.",
  image: a.bannerImage || a.coverImage.extraLarge || a.coverImage.large || "",
  genres: a.genres || [],
  rating: a.averageScore || 0,
}));
---

<Layout title="Accueil">
  {heroItems.length > 0 && <Hero items={heroItems} />}

  <div
    class="max-w-[1600px] mx-auto px-4 md:px-8 mt-12 md:mt-16 relative z-20 space-y-20 pb-24"
  >
    <!-- Section History -->
    <section id="history-section" class="hidden space-y-6 relative group/row">
      <div class="px-2">
        <h2
          class="text-xl md:text-2xl font-black text-[#E5E7EB] tracking-tight uppercase"
        >
          Reprendre la lecture
        </h2>
      </div>

      <div class="relative">
        <button
          class="scroll-btn absolute -left-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 bg-[#1E293B]/90 text-white rounded-full border border-[#3B82F6]/20 shadow-2xl opacity-0 group-hover/row:opacity-100 transition-all flex items-center justify-center hover:bg-[#3B82F6] hover:scale-110"
          data-target="history-list"
          data-dir="prev"
        >
          <ChevronLeft size={28} />
        </button>

        <div
          class="flex gap-4 md:gap-6 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x px-2"
          id="history-list"
        >
          <!-- JS Injection -->
        </div>

        <button
          class="scroll-btn absolute -right-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 bg-[#1E293B]/90 text-white rounded-full border border-[#3B82F6]/20 shadow-2xl opacity-0 group-hover/row:opacity-100 transition-all flex items-center justify-center hover:bg-[#3B82F6] hover:scale-110"
          data-target="history-list"
          data-dir="next"
        >
          <ChevronRight size={28} />
        </button>
      </div>
    </section>

    <!-- Section Simulcasts -->
    <section class="space-y-6 relative group/row">
      <div class="px-2 space-y-1">
        <h2
          class="text-xl md:text-2xl font-black text-[#E5E7EB] tracking-tight uppercase"
        >
          Simulcasts (Saison Hiver 2026)
        </h2>
        <p class="text-xs md:text-sm text-[#9CA3AF] font-medium italic">
          Sélectionnés avec passion sur Anime-Sama.
        </p>
      </div>

      <div class="relative">
        <button
          class="scroll-btn absolute -left-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 bg-[#1E293B]/90 text-white rounded-full border border-[#3B82F6]/20 shadow-2xl opacity-0 group-hover/row:opacity-100 transition-all flex items-center justify-center hover:bg-[#3B82F6] hover:scale-110"
          data-target="simulcasts-scroll"
          data-dir="prev"
        >
          <ChevronLeft size={28} />
        </button>

        <div
          class="flex gap-4 md:gap-6 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x px-2"
          id="simulcasts-scroll"
        >
          {
            simulcasts.map((anime) => (
              <div class="flex-none w-40 md:w-52 snap-start">
                <AnimeCard
                  id={anime.id}
                  image={anime.coverImage.large}
                  title={anime.title.romaji || anime.title.english}
                  type={anime.format}
                />
              </div>
            ))
          }
        </div>

        <button
          class="scroll-btn absolute -right-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 bg-[#1E293B]/90 text-white rounded-full border border-[#3B82F6]/20 shadow-2xl opacity-0 group-hover/row:opacity-100 transition-all flex items-center justify-center hover:bg-[#3B82F6] hover:scale-110"
          data-target="simulcasts-scroll"
          data-dir="next"
        >
          <ChevronRight size={28} />
        </button>
      </div>
    </section>

    <!-- Section Sorties -->
    <section class="space-y-6 relative group/row">
      <div class="px-2">
        <h2
          class="text-xl md:text-2xl font-black text-[#E5E7EB] tracking-tight uppercase"
        >
          Tendance en France
        </h2>
      </div>

      <div class="relative">
        <button
          class="scroll-btn absolute -left-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 bg-[#1E293B]/90 text-white rounded-full border border-[#3B82F6]/20 shadow-2xl opacity-0 group-hover/row:opacity-100 transition-all flex items-center justify-center hover:bg-[#3B82F6] hover:scale-110"
          data-target="latest-scroll"
          data-dir="prev"
        >
          <ChevronLeft size={28} />
        </button>

        <div
          class="flex gap-4 md:gap-6 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x px-2"
          id="latest-scroll"
        >
          {
            latest.map((anime) => (
              <div class="flex-none w-40 md:w-52 snap-start">
                <AnimeCard
                  id={anime.id}
                  image={anime.coverImage.large}
                  title={anime.title.romaji || anime.title.english}
                  type={anime.format}
                />
              </div>
            ))
          }
        </div>

        <button
          class="scroll-btn absolute -right-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 bg-[#1E293B]/90 text-white rounded-full border border-[#3B82F6]/20 shadow-2xl opacity-0 group-hover/row:opacity-100 transition-all flex items-center justify-center hover:bg-[#3B82F6] hover:scale-110"
          data-target="latest-scroll"
          data-dir="next"
        >
          <ChevronRight size={28} />
        </button>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupDynamicSections() {
    const historyList = document.getElementById("history-list");
    const historySection = document.getElementById("history-section");
    const history = JSON.parse(
      localStorage.getItem("yvlos_global_history") || "[]",
    );

    if (history.length > 0 && historyList && historySection) {
      historySection.classList.remove("hidden");
      historyList.innerHTML = history
        .map(
          (a: any) => `
        <div class="flex-none w-40 md:w-52 snap-start">
            <a href="/anime/${a.id}?ep=${a.lastEp || 1}" class="group block w-full">
                <div class="relative aspect-[2/3] w-full rounded-md overflow-hidden bg-[#1E293B] transition-all duration-500 group-hover:shadow-2xl group-hover:shadow-[#3B82F6]/20">
                    <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                    <div class="absolute bottom-2 left-2 bg-[#3B82F6] text-white text-[9px] font-black px-1.5 py-0.5 rounded shadow-lg">EP ${a.lastEp}</div>
                    <div class="absolute bottom-0 left-0 w-full h-1 bg-black/20">
                        <div class="h-full bg-[#3B82F6] w-full"></div>
                    </div>
                </div>
                <div class="mt-3">
                    <h3 class="text-xs md:text-sm font-bold text-[#E5E7EB] dark:text-[#E5E7EB] line-clamp-2 leading-tight min-h-[2rem] md:min-h-[2.5rem] group-hover:text-[#60A5FA] transition-colors">${a.title}</h3>
                    <p class="text-[10px] md:text-xs text-[#9CA3AF] font-medium italic">${a.type === "TV" ? "Série" : a.type || "Anime"}</p>
                </div>
            </a>
        </div>
      `,
        )
        .join("");
    }
  }

  function setupScrollButtons() {
    document.querySelectorAll(".scroll-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const dir = btn.getAttribute("data-dir");
        if (!targetId || !dir) return;
        const list = document.getElementById(targetId);
        if (list) {
          const amount = list.clientWidth * 0.8;
          list.scrollBy({
            left: dir === "next" ? amount : -amount,
            behavior: "smooth",
          });
        }
      });
    });
  }

  setupDynamicSections();
  setupScrollButtons();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
