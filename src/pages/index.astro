---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AnimeCard from "../components/AnimeCard.astro";
import {
  getPopularAnime,
  getTrendingAnime,
  getLatestAnime,
  getAnimeListByIds,
} from "../lib/anilist";
import libraryData from "../data/library.json";
import {
  History,
  Zap,
  Clock,
  ChevronLeft,
  ChevronRight,
  Library,
} from "lucide-astro";

export const prerender = false;

let popular: any[] = [];
let simulcasts: any[] = [];
let latest: any[] = [];
let error: string | null = null;

try {
  const libraryIds = libraryData.featured.map((a) => a.id);
  const [popData, simData, latData, libData] = await Promise.all([
    getPopularAnime(25),
    getTrendingAnime(25),
    getLatestAnime(25),
    getAnimeListByIds(libraryIds),
  ]);

  const clean = (list: any[]) =>
    list.filter(
      (a) =>
        a &&
        a.id &&
        a.coverImage?.large &&
        !a.isAdult &&
        !a.genres?.some((g: string) =>
          ["Hentai", "Ecchi", "Erotica", "Yaoi", "Yuri"].includes(g),
        ),
    );

  popular = clean(libData);
  simulcasts = clean(simData);
  latest = clean(latData);
} catch (e) {
  console.error("Failed to fetch AniList data:", e);
  error = "Une erreur est survenue lors de la récupération des données.";
}

const heroAnime =
  popular.find((a) => a.bannerImage && a.description) || popular[0];
const heroProps = heroAnime
  ? {
      id: heroAnime.id,
      title: heroAnime.title.romaji || heroAnime.title.english,
      description: heroAnime.description || "Découvrez cet anime sur Yvlos.",
      image:
        heroAnime.bannerImage ||
        heroAnime.coverImage.extraLarge ||
        heroAnime.coverImage.large ||
        "",
      genres: heroAnime.genres || [],
      rating: heroAnime.averageScore || 0,
    }
  : null;
---

<Layout title="Accueil">
  {
    heroProps ? (
      <Hero {...heroProps} />
    ) : (
      <div class="flex items-center justify-center h-[40vh] text-red-500 font-bold">
        <p>{error || "Chargement..."}</p>
      </div>
    )
  }

  <div
    class="max-w-screen-xl mx-auto px-4 -mt-12 md:-mt-28 relative z-20 space-y-20 pb-24"
  >
    <!-- Section History -->
    <section id="history-section" class="hidden space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white flex items-center gap-4 uppercase tracking-tighter"
        >
          <History class="text-blue-500" size={32} />
          Reprendre
        </h2>
        <div class="flex gap-3">
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="history-list"
            data-dir="prev"
          >
            <ChevronLeft size={24} class="dark:text-white" />
          </button>
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="history-list"
            data-dir="next"
          >
            <ChevronRight size={24} class="dark:text-white" />
          </button>
        </div>
      </div>
      <div
        class="flex gap-5 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x"
        id="history-list"
      >
        <!-- JS Injection -->
      </div>
    </section>

    <!-- Section Simulcasts -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white flex items-center gap-4 uppercase tracking-tighter"
        >
          <Zap class="text-yellow-400" size={32} />
          Simulcasts
        </h2>
        <div class="flex gap-3">
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="simulcasts-scroll"
            data-dir="prev"
          >
            <ChevronLeft size={24} class="dark:text-white" />
          </button>
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="simulcasts-scroll"
            data-dir="next"
          >
            <ChevronRight size={24} class="dark:text-white" />
          </button>
        </div>
      </div>
      <div
        class="flex gap-5 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x"
        id="simulcasts-scroll"
      >
        {
          simulcasts.map((anime) => (
            <div class="flex-none w-44 md:w-56 snap-start">
              <AnimeCard
                id={anime.id}
                image={anime.coverImage.large}
                title={anime.title.romaji || anime.title.english}
                type={anime.format}
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section Favorites -->
    <div id="favorites-section" class="hidden space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white flex items-center gap-4 uppercase tracking-tighter"
        >
          <Clock class="text-pink-500" size={32} />
          Favoris
        </h2>
        <div class="flex gap-3">
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="favorites-list"
            data-dir="prev"
          >
            <ChevronLeft size={24} class="dark:text-white" />
          </button>
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="favorites-list"
            data-dir="next"
          >
            <ChevronRight size={24} class="dark:text-white" />
          </button>
        </div>
      </div>
      <div
        class="flex gap-5 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x"
        id="favorites-list"
      >
        <!-- JS Injection -->
      </div>
    </div>

    <!-- Section Sorties -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white flex items-center gap-4 uppercase tracking-tighter"
        >
          <Clock class="text-green-500" size={32} />
          Sorties
        </h2>
        <div class="flex gap-3">
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="latest-scroll"
            data-dir="prev"
          >
            <ChevronLeft size={24} class="dark:text-white" />
          </button>
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="latest-scroll"
            data-dir="next"
          >
            <ChevronRight size={24} class="dark:text-white" />
          </button>
        </div>
      </div>
      <div
        class="flex gap-5 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x"
        id="latest-scroll"
      >
        {
          latest.map((anime) => (
            <div class="flex-none w-44 md:w-56 snap-start">
              <AnimeCard
                id={anime.id}
                image={anime.coverImage.large}
                title={anime.title.romaji || anime.title.english}
                type={anime.format}
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section Librairie -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white flex items-center gap-4 uppercase tracking-tighter"
        >
          <Library class="text-blue-600" size={32} />
          Librairie
        </h2>
        <div class="flex gap-3">
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="popular-scroll"
            data-dir="prev"
          >
            <ChevronLeft size={24} class="dark:text-white" />
          </button>
          <button
            class="scroll-btn w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all active:scale-95"
            data-target="popular-scroll"
            data-dir="next"
          >
            <ChevronRight size={24} class="dark:text-white" />
          </button>
        </div>
      </div>
      <div
        class="flex gap-5 overflow-x-auto pb-4 scrollbar-hide scroll-smooth snap-x"
        id="popular-scroll"
      >
        {
          popular.map((anime) => (
            <div class="flex-none w-44 md:w-56 snap-start">
              <AnimeCard
                id={anime.id}
                image={anime.coverImage.large}
                title={anime.title.romaji || anime.title.english}
                type={anime.format}
              />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupDynamicSections() {
    const historyList = document.getElementById("history-list");
    const historySection = document.getElementById("history-section");
    const history = JSON.parse(
      localStorage.getItem("yvlos_global_history") || "[]",
    );

    if (history.length > 0 && historyList && historySection) {
      historySection.classList.remove("hidden");
      historyList.innerHTML = history
        .map(
          (a: any) => `
        <div class="flex-none w-44 md:w-56 snap-start">
            <a href="/anime/${a.id}?ep=${a.lastEp || 1}" class="group block w-full">
                <div class="relative aspect-[2/3] w-full rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800/50 transition-colors bg-white dark:bg-gray-950">
                    <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                    <div class="absolute top-3 left-3 bg-blue-600 text-white text-[10px] font-black px-2.5 py-1 rounded-lg shadow-xl uppercase tracking-widest">ÉP. ${a.lastEp}</div>
                    <div class="absolute bottom-0 left-0 w-full h-1.5 bg-black/20">
                        <div class="h-full bg-blue-600 w-full"></div>
                    </div>
                </div>
                <div class="mt-3 px-1">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] transition-colors">${a.title}</h3>
                    <p class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-1">${a.type || "Anime"}</p>
                </div>
            </a>
        </div>
      `,
        )
        .join("");
    }

    const favList = document.getElementById("favorites-list");
    const favSection = document.getElementById("favorites-section");
    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );

    if (favorites.length > 0 && favList && favSection) {
      favSection.classList.remove("hidden");
      favList.innerHTML = favorites
        .map(
          (a: any) => `
        <div class="flex-none w-44 md:w-56 snap-start">
            <a href="/anime/${a.id}" class="group block w-full">
                <div class="relative aspect-[2/3] w-full rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800/50 transition-colors bg-white dark:bg-gray-950">
                    <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                </div>
                <div class="mt-3 px-1">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] transition-colors">${a.title}</h3>
                    <p class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-1">${a.type || "Anime"}</p>
                </div>
            </a>
        </div>
      `,
        )
        .join("");
    }
  }

  function setupScrollButtons() {
    document.querySelectorAll(".scroll-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const dir = btn.getAttribute("data-dir");
        if (!targetId || !dir) return;
        const list = document.getElementById(targetId);
        if (list) {
          const amount = list.clientWidth * 0.9;
          list.scrollBy({
            left: dir === "next" ? amount : -amount,
            behavior: "smooth",
          });
        }
      });
    });
  }

  setupDynamicSections();
  setupScrollButtons();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
