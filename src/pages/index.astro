---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AnimeCard from "../components/AnimeCard.astro";
import {
  getPopularAnime,
  getTrendingAnime,
  getLatestAnime,
  getAnimeListByIds,
} from "../lib/anilist";
import libraryData from "../data/library.json";
import {
  Star,
  History,
  Zap,
  Clock,
  ChevronLeft,
  ChevronRight,
  Library,
} from "lucide-astro";

export const prerender = false;

let popular: any[] = [];
let simulcasts: any[] = [];
let latest: any[] = [];
let error: string | null = null;

try {
  const libraryIds = libraryData.featured.map((a) => a.id);
  const [popData, simData, latData, libData] = await Promise.all([
    getPopularAnime(25),
    getTrendingAnime(25),
    getLatestAnime(25),
    getAnimeListByIds(libraryIds),
  ]);

  const clean = (list: any[]) =>
    list.filter(
      (a) =>
        a &&
        a.id &&
        a.coverImage?.large &&
        !a.isAdult &&
        !a.genres?.some((g: string) =>
          ["Hentai", "Ecchi", "Erotica", "Yaoi", "Yuri"].includes(g),
        ),
    );

  // Map custom tags from libraryData
  popular = clean(libData).map((a) => {
    const libEntry = libraryData.featured.find((f) => f.id === a.id);
    return { ...a, tag: libEntry?.tag };
  });

  simulcasts = clean(simData);
  latest = clean(latData);
} catch (e) {
  console.error("Failed to fetch AniList data:", e);
  error = "Une erreur est survenue lors de la récupération des données.";
}

const heroAnime =
  popular.find((a) => a.bannerImage && a.description) || popular[0];
const heroProps = heroAnime
  ? {
      id: heroAnime.id,
      title: heroAnime.title.romaji || heroAnime.title.english,
      description: heroAnime.description || "Découvrez cet anime sur Yvlos.",
      image:
        heroAnime.bannerImage ||
        heroAnime.coverImage.extraLarge ||
        heroAnime.coverImage.large ||
        "",
      genres: heroAnime.genres || [],
      rating: heroAnime.averageScore || 0,
    }
  : null;
---

<Layout title="Accueil">
  {
    heroProps ? (
      <Hero {...heroProps} />
    ) : (
      <div class="flex items-center justify-center h-[40vh] text-red-500 font-bold">
        <p>{error || "Chargement..."}</p>
      </div>
    )
  }

  <div
    class="max-w-screen-xl mx-auto px-4 -mt-10 md:-mt-24 relative z-20 space-y-16 pb-20"
  >
    <!-- Reprendre la lecture -->
    <section id="history-section" class="hidden space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-xl md:text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3 uppercase tracking-tight"
        >
          <History class="text-blue-500" size={28} />
          Reprendre
        </h2>
        <div class="flex gap-2">
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="history-list"
            data-dir="prev"
          >
            <ChevronLeft size={20} />
          </button>
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="history-list"
            data-dir="next"
          >
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
      <div
        class="flex gap-4 md:gap-6 overflow-x-auto pb-6 scrollbar-hide scroll-smooth snap-x"
        id="history-list"
      >
        <!-- JS Injection -->
      </div>
    </section>

    <!-- Simulcasts -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-xl md:text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3 uppercase tracking-tight"
        >
          <Zap class="text-yellow-400" size={28} />
          Simulcasts
        </h2>
        <div class="flex gap-2">
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="simulcasts-scroll"
            data-dir="prev"
          >
            <ChevronLeft size={20} />
          </button>
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="simulcasts-scroll"
            data-dir="next"
          >
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
      <div
        class="flex gap-4 md:gap-6 overflow-x-auto pb-6 scrollbar-hide scroll-smooth snap-x"
        id="simulcasts-scroll"
      >
        {
          simulcasts.map((anime) => (
            <div class="flex-none w-40 md:w-56 snap-start">
              <AnimeCard
                id={anime.id}
                image={anime.coverImage.large}
                title={anime.title.romaji || anime.title.english}
                type={anime.format}
                rating={anime.averageScore}
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Favorites (Dynamic) -->
    <div id="favorites-section" class="hidden space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-xl md:text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3 uppercase tracking-tight"
        >
          <Star class="text-pink-500" size={28} />
          Coups de cœur
        </h2>
        <div class="flex gap-2">
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="favorites-list"
            data-dir="prev"
          >
            <ChevronLeft size={20} />
          </button>
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="favorites-list"
            data-dir="next"
          >
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
      <div
        class="flex gap-4 md:gap-6 overflow-x-auto pb-6 scrollbar-hide scroll-smooth snap-x"
        id="favorites-list"
      >
        <!-- JS Injection -->
      </div>
    </div>

    <!-- Dernières Sorties -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-xl md:text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3 uppercase tracking-tight"
        >
          <Clock class="text-green-500" size={28} />
          Dernières Sorties
        </h2>
        <div class="flex gap-2">
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="latest-list"
            data-dir="prev"
          >
            <ChevronLeft size={20} />
          </button>
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="latest-list"
            data-dir="next"
          >
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
      <div
        class="flex gap-4 md:gap-6 overflow-x-auto pb-6 scrollbar-hide scroll-smooth snap-x"
        id="latest-list"
      >
        {
          latest.map((anime) => (
            <div class="flex-none w-40 md:w-56 snap-start">
              <AnimeCard
                id={anime.id}
                image={anime.coverImage.large}
                title={anime.title.romaji || anime.title.english}
                type={`${anime.format || "TV"} • ${anime.genres?.[0] || "Anime"}`}
                rating={anime.averageScore}
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- La Librairie -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2
          class="text-xl md:text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3 uppercase tracking-tight"
        >
          <Library class="text-blue-600" size={28} />
          La Librairie
        </h2>
        <div class="flex gap-2">
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="popular-list"
            data-dir="prev"
          >
            <ChevronLeft size={20} />
          </button>
          <button
            class="scroll-btn p-2 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-800 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all shadow-sm"
            data-target="popular-list"
            data-dir="next"
          >
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
      <div
        class="flex gap-4 md:gap-6 overflow-x-auto pb-6 scrollbar-hide scroll-smooth snap-x"
        id="popular-list"
      >
        {
          popular.map((anime) => (
            <div class="flex-none w-40 md:w-56 snap-start">
              <AnimeCard
                id={anime.id}
                image={anime.coverImage.large}
                title={anime.title.romaji || anime.title.english}
                type={`${anime.format || "TV"} • ${anime.genres?.[0] || "Anime"}`}
                tag={anime.tag}
                rating={anime.averageScore}
              />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupDynamicSections() {
    // History
    const historyList = document.getElementById("history-list");
    const historySection = document.getElementById("history-section");
    const history = JSON.parse(
      localStorage.getItem("yvlos_global_history") || "[]",
    );

    if (history.length > 0 && historyList && historySection) {
      historySection.classList.remove("hidden");
      historyList.innerHTML = history
        .map(
          (a: any) => `
        <div class="flex-none w-40 md:w-56 snap-start h-full">
            <a href="/anime/${a.id}?ep=${a.lastEp || 1}" class="group block h-full">
                <div class="flex flex-col h-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden transition-all duration-300 hover:border-blue-500/50 hover:shadow-xl group-hover:-translate-y-1">
                    <div class="aspect-[2/3] w-full relative overflow-hidden">
                        <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute bottom-0 left-0 w-full h-1 bg-gray-700/50">
                            <div class="h-full bg-blue-600" style="width: 100%"></div>
                        </div>
                        <div class="absolute top-2 right-2 bg-blue-600 text-white text-[10px] font-black px-2 py-1 rounded-lg uppercase tracking-wider">ÉP. ${a.lastEp}</div>
                    </div>
                    <div class="p-3 flex flex-col flex-1 gap-1">
                        <h3 class="text-xs md:text-sm font-bold text-gray-900 dark:text-white line-clamp-2 min-h-[2.5rem] leading-tight group-hover:text-blue-500">${a.title}</h3>
                        <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-auto">${a.type || "Anime"}</p>
                    </div>
                </div>
            </a>
        </div>
      `,
        )
        .join("");
    }

    // Favorites
    const favList = document.getElementById("favorites-list");
    const favSection = document.getElementById("favorites-section");
    const favorites = JSON.parse(
      localStorage.getItem("yvlos_favorites") || "[]",
    );

    if (favorites.length > 0 && favList && favSection) {
      favSection.classList.remove("hidden");
      favList.innerHTML = favorites
        .map(
          (a: any) => `
        <div class="flex-none w-40 md:w-56 snap-start h-full">
            <a href="/anime/${a.id}" class="group block h-full">
                <div class="flex flex-col h-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden transition-all duration-300 hover:border-blue-500/50 hover:shadow-xl group-hover:-translate-y-1">
                    <div class="aspect-[2/3] w-full relative overflow-hidden">
                        <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute top-2 right-2 bg-pink-600 text-white text-[10px] font-black px-2 py-1 rounded-lg uppercase tracking-wider">FAV</div>
                    </div>
                    <div class="p-3 flex flex-col flex-1 gap-1">
                        <h3 class="text-xs md:text-sm font-bold text-gray-900 dark:text-white line-clamp-2 min-h-[2.5rem] leading-tight group-hover:text-blue-500">${a.title}</h3>
                        <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-auto">${a.type || "Anime"}</p>
                    </div>
                </div>
            </a>
        </div>
      `,
        )
        .join("");
    }
  }

  function setupScrollButtons() {
    const buttons = document.querySelectorAll(".scroll-btn");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const dir = btn.getAttribute("data-dir");
        if (!targetId || !dir) return;

        const list = document.getElementById(targetId);
        if (list) {
          const scrollAmount = list.clientWidth * 0.8;
          list.scrollBy({
            left: dir === "next" ? scrollAmount : -scrollAmount,
            behavior: "smooth",
          });
        }
      });
    });
  }

  // Init
  setupDynamicSections();
  setupScrollButtons();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
