---
import Layout from "../layouts/Layout.astro";
import { LogIn, Mail, Lock, Github, Chrome, MessageSquare } from "lucide-astro";

export const prerender = true;
---

<Layout title="Connexion">
  <section
    class="bg-gray-50 dark:bg-gray-950 min-h-screen flex items-center justify-center p-4"
  >
    <div
      class="w-full max-w-md bg-white rounded-2xl shadow-xl dark:border dark:bg-gray-900 dark:border-gray-800 p-8 space-y-6"
    >
      <div class="text-center space-y-2">
        <div
          class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-500 rounded-2xl mb-4"
        >
          <LogIn size={32} />
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          Bon retour !
        </h1>
        <p class="text-gray-500 dark:text-gray-400">
          Connectez-vous pour continuer l'aventure sur Yvlos
        </p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label
            for="email"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
            >Email</label
          >
          <div class="relative">
            <div
              class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
            >
              <Mail size={18} class="text-gray-500 dark:text-gray-400" />
            </div>
            <input
              type="email"
              id="email"
              name="email"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-3 dark:bg-gray-800 dark:border-gray-700 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
              placeholder="votre@email.com"
              required
            />
          </div>
        </div>
        <div>
          <label
            for="password"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
            >Mot de passe</label
          >
          <div class="relative">
            <div
              class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
            >
              <Lock size={18} class="text-gray-500 dark:text-gray-400" />
            </div>
            <input
              type="password"
              id="password"
              name="password"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-3 dark:bg-gray-800 dark:border-gray-700 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
              placeholder="••••••••"
              required
            />
          </div>
        </div>

        <button
          type="submit"
          class="w-full text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-bold rounded-xl text-sm px-5 py-3 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-all"
        >
          Se connecter
        </button>
      </form>

      <div class="flex items-center my-6">
        <div class="flex-grow border-t border-gray-200 dark:border-gray-800">
        </div>
        <span
          class="flex-shrink mx-4 text-gray-400 text-xs font-bold uppercase tracking-widest"
          >OU</span
        >
        <div class="flex-grow border-t border-gray-200 dark:border-gray-800">
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <button
          class="flex items-center justify-center p-2.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          onclick="alert('Bientôt disponible !')"
        >
          <MessageSquare size={20} class="text-[#5865F2]" />
        </button>
        <button
          class="flex items-center justify-center p-2.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          onclick="alert('Bientôt disponible !')"
        >
          <Chrome size={20} class="text-[#EA4335]" />
        </button>
        <button
          class="flex items-center justify-center p-2.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          onclick="alert('Bientôt disponible !')"
        >
          <Github size={20} class="dark:text-white" />
        </button>
      </div>

      <p class="text-sm text-center text-gray-500 dark:text-gray-400">
        Pas encore de compte ? <a
          href="/register"
          class="font-bold text-blue-600 hover:underline dark:text-blue-500"
          >S'inscrire</a
        >
      </p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;

  form?.addEventListener("submit", async (e: Event) => {
    e.preventDefault();
    const formData = new FormData(form);
    const email = formData.get("email");
    const password = formData.get("password");

    try {
      const res = await fetch("/api/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "login", email, password }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      localStorage.setItem(
        "yvlos_session",
        JSON.stringify({
          ...data.user,
          stats: {
            episodesSeen: data.user.stats_episodes_seen || 0,
            completed: 0,
            watchedTime: 0,
          },
        }),
      );

      window.location.href = "/profile";
    } catch (err: any) {
      alert(err.message || "Erreur lors de la connexion");
    }
  });
</script>
