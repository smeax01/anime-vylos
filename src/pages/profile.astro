---
import Layout from "../layouts/Layout.astro";
import {
  User,
  Clock,
  Heart,
  Play,
  Camera,
  LogOut,
  Calendar,
  BarChart3,
  ChevronRight,
} from "lucide-astro";

export const prerender = true;
---

<Layout title="Profil">
  <!-- Not Logged In State -->
  <div
    id="not-logged-in"
    class="hidden min-h-[70vh] flex flex-col items-center justify-center p-4"
  >
    <div class="text-center space-y-6 max-w-sm">
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 dark:bg-gray-800 text-gray-400 rounded-full"
      >
        <User size={48} />
      </div>
      <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white">
        Non connecté
      </h2>
      <p class="text-gray-500 dark:text-gray-400">
        Rejoignez Yvlos dès maintenant pour sauvegarder votre progression et vos
        favoris.
      </p>
      <div class="flex flex-col gap-3">
        <a
          href="/login"
          class="px-6 py-3 text-white bg-blue-700 hover:bg-blue-800 font-bold rounded-xl transition-colors"
          >Se connecter</a
        >
        <a
          href="/register"
          class="px-6 py-3 text-gray-900 dark:text-white bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 font-bold rounded-xl transition-colors"
          >Créer un compte</a
        >
      </div>
    </div>
  </div>

  <!-- Profile Content -->
  <div
    id="profile-content"
    class="hidden max-w-screen-xl mx-auto px-4 py-12 space-y-12 pb-24"
  >
    <!-- Profile Header -->
    <div
      class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-3xl p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-8 shadow-sm"
    >
      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <div class="relative group">
          <img
            id="user-avatar"
            src=""
            alt="Avatar"
            class="w-32 h-32 md:w-40 md:h-40 rounded-3xl object-cover border-4 border-blue-600/20 shadow-xl"
          />
          <button
            class="absolute -bottom-2 -right-2 bg-blue-600 text-white p-2.5 rounded-xl shadow-lg hover:scale-110 transition-transform"
            onclick="alert('Bientôt disponible !')"
          >
            <Camera size={18} />
          </button>
        </div>
        <div class="text-center md:text-left space-y-2">
          <span
            class="inline-block px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-500 text-xs font-bold rounded-lg mb-2"
            >Membre Premium</span
          >
          <h1
            id="user-name"
            class="text-4xl font-black text-gray-900 dark:text-white tracking-tight"
          >
            Utilisateur
          </h1>
          <p
            id="user-email"
            class="text-gray-500 dark:text-gray-400 font-medium italic"
          >
            utilisateur@yvlos.fr
          </p>
        </div>
      </div>
      <button
        id="logout-btn"
        class="flex items-center gap-2 px-6 py-3 text-red-600 dark:text-red-500 bg-red-50 dark:bg-red-900/10 hover:bg-red-100 dark:hover:bg-red-900/20 font-bold rounded-xl md:self-start transition-colors"
      >
        <LogOut size={20} />
        Déconnexion
      </button>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div
        class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 flex items-center gap-5 shadow-sm"
      >
        <div
          class="p-4 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-500 rounded-2xl"
        >
          <BarChart3 size={32} />
        </div>
        <div>
          <p
            id="stat-time"
            class="text-2xl font-black text-gray-900 dark:text-white"
          >
            0h
          </p>
          <p
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"
          >
            Temps de visionnage
          </p>
        </div>
      </div>
      <div
        class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 flex items-center gap-5 shadow-sm"
      >
        <div
          class="p-4 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-500 rounded-2xl"
        >
          <Play size={32} />
        </div>
        <div>
          <p
            id="stat-episodes"
            class="text-2xl font-black text-gray-900 dark:text-white"
          >
            0
          </p>
          <p
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"
          >
            Épisodes vus
          </p>
        </div>
      </div>
      <div
        class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 flex items-center gap-5 shadow-sm"
      >
        <div
          class="p-4 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-500 rounded-2xl"
        >
          <Clock size={32} />
        </div>
        <div>
          <p
            id="stat-completed"
            class="text-2xl font-black text-gray-900 dark:text-white"
          >
            0
          </p>
          <p
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider"
          >
            Séries terminées
          </p>
        </div>
      </div>
    </div>

    <!-- Content Tabs -->
    <div class="space-y-6">
      <div class="border-b border-gray-200 dark:border-gray-800">
        <ul
          class="flex flex-wrap -mb-px text-sm font-bold text-center text-gray-500 dark:text-gray-400"
        >
          <li class="me-2">
            <button
              class="tab-btn inline-block p-4 border-b-2 rounded-t-lg transition-all"
              data-tab="history">Mon Historique</button
            >
          </li>
          <li class="me-2">
            <button
              class="tab-btn inline-block p-4 border-b-2 rounded-t-lg transition-all border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300"
              data-tab="favorites">Mes Favoris</button
            >
          </li>
        </ul>
      </div>

      <!-- Tab Content -->
      <div id="tab-history" class="tab-content transition-opacity duration-300">
        <div
          id="history-list"
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6"
        >
          <!-- Data injection -->
        </div>
      </div>

      <div
        id="tab-favorites"
        class="tab-content hidden transition-opacity duration-300"
      >
        <div
          id="favorites-list"
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6"
        >
          <!-- Data injection -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initProfile() {
    const sessionStr = localStorage.getItem("yvlos_session");
    if (!sessionStr) {
      document.getElementById("not-logged-in")?.classList.remove("hidden");
      return;
    }

    const user = JSON.parse(sessionStr);
    document.getElementById("profile-content")?.classList.remove("hidden");

    // Profile info
    const avatarEl = document.getElementById("user-avatar") as HTMLImageElement;
    if (avatarEl && user.avatar) avatarEl.src = user.avatar;

    const nameEl = document.getElementById("user-name");
    if (nameEl) nameEl.textContent = user.username;

    const emailEl = document.getElementById("user-email");
    if (emailEl) emailEl.textContent = user.email || "";

    // Stats
    const eps = user.stats?.episodesSeen || 0;
    const timeEl = document.getElementById("stat-time");
    if (timeEl) timeEl.textContent = `${Math.floor((eps * 24) / 60)}h`;

    const epEl = document.getElementById("stat-episodes");
    if (epEl) epEl.textContent = eps.toString();

    const compEl = document.getElementById("stat-completed");
    if (compEl) compEl.textContent = (user.stats?.completed || 0).toString();

    renderHistory();
    renderFavorites();

    // Tab Logic
    const tabs = document.querySelectorAll(".tab-btn");
    const SET_ACTIVE =
      "text-blue-600 border-blue-600 dark:text-blue-500 dark:border-blue-500";
    const SET_INACTIVE =
      "border-transparent hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300";

    function updateTabs(activeId: string) {
      tabs.forEach((tab) => {
        const isTabActive = tab.getAttribute("data-tab") === activeId;
        tab.className = `tab-btn inline-block p-4 border-b-2 rounded-t-lg transition-all ${isTabActive ? SET_ACTIVE : SET_INACTIVE}`;

        const content = document.getElementById(
          `tab-${tab.getAttribute("data-tab")}`,
        );
        if (content) {
          if (isTabActive) content.classList.remove("hidden");
          else content.classList.add("hidden");
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () =>
        updateTabs(tab.getAttribute("data-tab") || "history"),
      );
    });

    // Default tab
    updateTabs("history");

    // Logout
    document.getElementById("logout-btn")?.addEventListener("click", () => {
      localStorage.removeItem("yvlos_session");
      window.location.href = "/login";
    });
  }

  function renderHistory() {
    const list = document.getElementById("history-list");
    const data = JSON.parse(
      localStorage.getItem("yvlos_global_history") || "[]",
    );

    if (!list) return;

    if (data.length === 0) {
      list.innerHTML = `<div class="col-span-full py-20 text-center text-gray-500 font-medium">Ton historique est vide. Commence à regarder quelque chose !</div>`;
      return;
    }

    list.innerHTML = data
      .map(
        (a: any) => `
        <a href="/anime/${a.id}?ep=${a.lastEp || 1}" class="group">
            <div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 transition-all group-hover:shadow-lg">
                <div class="aspect-[2/3] w-full relative">
                    <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover">
                    <div class="absolute bottom-0 left-0 w-full h-1.5 bg-gray-200 dark:bg-gray-800">
                        <div class="h-full bg-blue-600" style="width: 100%"></div>
                    </div>
                </div>
                <div class="p-3">
                    <h3 class="text-xs font-bold text-gray-900 dark:text-white line-clamp-2">${a.title}</h3>
                    <p class="text-[10px] text-gray-500 uppercase mt-1">ÉPISODE ${a.lastEp}</p>
                </div>
            </div>
        </a>
    `,
      )
      .join("");
  }

  function renderFavorites() {
    const list = document.getElementById("favorites-list");
    const data = JSON.parse(localStorage.getItem("yvlos_favorites") || "[]");

    if (!list) return;

    if (data.length === 0) {
      list.innerHTML = `<div class="col-span-full py-20 text-center text-gray-500 font-medium">Tes favoris s'afficheront ici.</div>`;
      return;
    }

    list.innerHTML = data
      .map(
        (a: any) => `
        <a href="/anime/${a.id}" class="group">
            <div class="relative overflow-hidden rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 transition-all group-hover:shadow-lg">
                <div class="aspect-[2/3] w-full relative">
                    <img src="${a.image}" alt="${a.title}" class="w-full h-full object-cover">
                    <div class="absolute top-2 right-2 p-1.5 bg-pink-100 dark:bg-pink-900/40 text-pink-600 dark:text-pink-500 rounded-lg backdrop-blur">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    </div>
                </div>
                <div class="p-3">
                    <h3 class="text-xs font-bold text-gray-900 dark:text-white line-clamp-2">${a.title}</h3>
                    <p class="text-[10px] text-gray-500 uppercase mt-1">${a.type || "Anime"}</p>
                </div>
            </div>
        </a>
    `,
      )
      .join("");
  }

  // Run on mount
  initProfile();
</script>
