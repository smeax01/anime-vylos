---
import Layout from "../layouts/Layout.astro";
import { User, Mail, Lock, UserPlus } from "lucide-astro";

export const prerender = true;
---

<Layout title="Inscription">
  <section
    class="bg-gray-50 dark:bg-gray-1000 min-h-screen flex items-center justify-center p-4"
  >
    <div
      class="w-full max-w-md bg-white rounded-2xl shadow-xl dark:border dark:bg-gray-900 dark:border-gray-800 p-8 space-y-6"
    >
      <div class="text-center space-y-2">
        <div
          class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-500 rounded-2xl mb-4"
        >
          <UserPlus size={32} />
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          Créer un compte
        </h1>
        <p class="text-gray-500 dark:text-gray-400">
          Rejoignez la communauté Yvlos dès aujourd'hui
        </p>
      </div>

      <form id="register-form" class="space-y-4">
        <div>
          <label
            for="username"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
            >Nom d'utilisateur</label
          >
          <div class="relative">
            <div
              class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
            >
              <User size={18} class="text-gray-500 dark:text-gray-400" />
            </div>
            <input
              type="text"
              id="username"
              name="username"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-3 dark:bg-gray-800 dark:border-gray-700 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
              placeholder="Smeax"
              required
            />
          </div>
        </div>
        <div>
          <label
            for="email"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
            >Email</label
          >
          <div class="relative">
            <div
              class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
            >
              <Mail size={18} class="text-gray-500 dark:text-gray-400" />
            </div>
            <input
              type="email"
              id="email"
              name="email"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-3 dark:bg-gray-800 dark:border-gray-700 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
              placeholder="votre@email.com"
              required
            />
          </div>
        </div>
        <div>
          <label
            for="password"
            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
            >Mot de passe</label
          >
          <div class="relative">
            <div
              class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
            >
              <Lock size={18} class="text-gray-500 dark:text-gray-400" />
            </div>
            <input
              type="password"
              id="password"
              name="password"
              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-3 dark:bg-gray-800 dark:border-gray-700 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
              placeholder="••••••••"
              required
            />
          </div>
        </div>

        <button
          type="submit"
          class="w-full text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-bold rounded-xl text-sm px-5 py-3 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-all"
        >
          S'inscrire
        </button>
      </form>

      <p class="text-sm text-center text-gray-500 dark:text-gray-400">
        Déjà un compte ? <a
          href="/login"
          class="font-bold text-blue-600 hover:underline dark:text-blue-500"
          >Se connecter</a
        >
      </p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("register-form") as HTMLFormElement;

  form?.addEventListener("submit", async (e: Event) => {
    e.preventDefault();
    const formData = new FormData(form);
    const username = formData.get("username");
    const email = formData.get("email");
    const password = formData.get("password");

    try {
      const res = await fetch("/api/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "register", username, email, password }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      localStorage.setItem(
        "yvlos_session",
        JSON.stringify({
          ...data.user,
          stats: { episodesSeen: 0, watchedTime: 0, completed: 0 },
        }),
      );

      window.location.href = "/profile";
    } catch (err: any) {
      alert(err.message || "Erreur lors de l'inscription");
    }
  });
</script>
