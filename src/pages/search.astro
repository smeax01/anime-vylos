---
import Layout from "../layouts/Layout.astro";
import { Search as SearchIcon } from "lucide-astro";
---

<Layout title="Recherche">
  <div
    class="max-w-[1600px] mx-auto px-4 md:px-8 py-8 min-h-[80vh] space-y-12 mt-4"
  >
    <!-- Large Search Bar -->
    <div class="relative max-w-4xl mx-auto">
      <div
        class="absolute inset-y-0 start-0 flex items-center ps-6 pointer-events-none"
      >
        <SearchIcon class="text-gray-500" size={28} />
      </div>
      <input
        type="text"
        id="search-input"
        class="block w-full p-6 ps-16 text-xl text-white border-2 border-white/5 rounded-2xl bg-white/5 focus:ring-4 focus:ring-orange-500/20 focus:border-orange-500 transition-all outline-none"
        placeholder="Quel anime cherchez-vous ?"
        autofocus
      />
    </div>

    <!-- Results Area -->
    <div
      id="results-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8"
    >
      <div class="col-span-full py-32 text-center space-y-6">
        <div
          class="inline-flex items-center justify-center w-28 h-28 bg-white/5 rounded-[2.5rem] text-gray-700"
        >
          <SearchIcon size={56} />
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl font-black text-white">Exploration</h2>
          <p class="text-gray-400 font-medium">
            Recherchez parmi des milliers d'animés sur Yvlos.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let debounceTimer: any;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const grid = document.getElementById("results-grid");

  input?.addEventListener("input", (e) => {
    clearTimeout(debounceTimer);
    const target = e.target as HTMLInputElement;
    const query = target.value;

    if (query.trim().length < 2) {
      if (grid)
        grid.innerHTML = `
        <div class="col-span-full py-32 text-center space-y-6">
            <div class="inline-flex items-center justify-center w-28 h-28 bg-white/5 rounded-[2.5rem] text-gray-700">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <div class="space-y-2">
                <h2 class="text-2xl font-black text-white">Exploration</h2>
                <p class="text-gray-400 font-medium">Recherchez parmi des milliers d'animés sur Yvlos.</p>
            </div>
        </div>
      `;
      return;
    }

    debounceTimer = setTimeout(async () => {
      if (grid)
        grid.innerHTML = `
            <div class="col-span-full py-32 text-center space-y-4">
                <div class="animate-spin rounded-full h-12 w-12 border-4 border-[#f47521] border-t-transparent mx-auto"></div>
                <p class="text-gray-400 font-medium italic">Recherche en cours...</p>
            </div>
      `;

      try {
        const queryGraphQL = `
          query ($search: String) {
            Page(perPage: 36) {
              media(search: $search, type: ANIME, sort: POPULARITY_DESC) {
                id
                title { romaji english }
                coverImage { large }
                format
              }
            }
          }
        `;

        const res = await fetch("https://graphql.anilist.co", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            query: queryGraphQL,
            variables: { search: query },
          }),
        });

        const { data } = await res.json();

        if (grid && data.Page.media.length > 0) {
          grid.innerHTML = data.Page.media
            .map(
              (anime: any) => `
            <a href="/anime/${anime.id}" class="group block w-full">
                <div class="relative aspect-[2/3] w-full rounded-md overflow-hidden bg-white/5">
                    <img src="${anime.coverImage.large}" loading="lazy" alt="${anime.title.romaji}" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                </div>
                <div class="mt-2">
                    <h3 class="text-xs md:text-sm font-bold text-white line-clamp-2 leading-tight min-h-[2.5rem] group-hover:text-[#f47521] transition-colors">${anime.title?.romaji || anime.title?.english}</h3>
                    <p class="text-[10px] md:text-xs text-gray-500 font-medium mt-0.5">${anime.format === "TV" ? "Série" : anime.format || "Anime"}</p>
                </div>
            </a>
          `,
            )
            .join("");
        } else if (grid) {
          grid.innerHTML = `<div class="col-span-full py-32 text-center text-gray-500 font-medium">Nous n'avons trouvé aucun résultat pour "${query}"...</div>`;
        }
      } catch (err) {
        if (grid)
          grid.innerHTML = `<div class="col-span-full py-32 text-center text-red-500/50 font-medium">Une erreur est survenue lors de la recherche.</div>`;
      }
    }, 400);
  });
</script>
