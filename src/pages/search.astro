---
import Layout from "../layouts/Layout.astro";
import { Search as SearchIcon } from "lucide-astro";
---

<Layout title="Recherche">
  <div class="max-w-screen-xl mx-auto px-4 py-8 min-h-[80vh] space-y-8">
    <!-- Search Header -->
    <div class="relative max-w-2xl mx-auto">
      <div
        class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none"
      >
        <SearchIcon class="text-blue-500" size={24} />
      </div>
      <input
        type="text"
        id="search-input"
        class="block w-full p-4 ps-12 text-lg text-gray-900 border border-gray-200 rounded-2xl bg-white focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-950 dark:border-gray-800 dark:placeholder-gray-400 dark:text-white shadow-sm transition-all"
        placeholder="Quel anime cherchez-vous ?"
        autofocus
      />
    </div>

    <!-- Results Area -->
    <div
      id="results-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6"
    >
      <div class="col-span-full py-20 text-center space-y-4">
        <div
          class="inline-flex items-center justify-center w-20 h-20 bg-gray-50 dark:bg-gray-900 rounded-3xl text-gray-300 dark:text-gray-700"
        >
          <SearchIcon size={40} />
        </div>
        <p class="text-gray-500 dark:text-gray-400 font-medium text-lg">
          Tapez le nom d'un anime pour explorer la bibliothèque
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  let debounceTimer: any;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const grid = document.getElementById("results-grid");

  input?.addEventListener("input", (e) => {
    clearTimeout(debounceTimer);
    const target = e.target as HTMLInputElement;
    const query = target.value;

    if (query.trim().length < 2) {
      if (grid)
        grid.innerHTML = `
        <div class="col-span-full py-20 text-center space-y-4">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-50 dark:bg-gray-900 rounded-3xl text-gray-300 dark:text-gray-700">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <p class="text-gray-500 dark:text-gray-400 font-medium text-lg">Tapez le nom d'un anime pour explorer la bibliothèque</p>
        </div>
      `;
      return;
    }

    debounceTimer = setTimeout(async () => {
      if (grid)
        grid.innerHTML = `
            <div class="col-span-full py-20 text-center space-y-4">
                <div class="inline-flex items-center justify-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-500 border-t-transparent"></div>
                </div>
                <p class="text-gray-500 dark:text-gray-400 font-medium">Recherche en cours...</p>
            </div>
      `;

      try {
        const queryGraphQL = `
          query ($search: String) {
            Page(perPage: 30) {
              media(search: $search, type: ANIME, sort: POPULARITY_DESC) {
                id
                title { romaji english }
                coverImage { large }
                format
                genres
                averageScore
              }
            }
          }
        `;

        const res = await fetch("https://graphql.anilist.co", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            query: queryGraphQL,
            variables: { search: query },
          }),
        });

        const { data } = await res.json();

        if (grid && data.Page.media.length > 0) {
          grid.innerHTML = data.Page.media
            .map(
              (anime: any) => `
            <a href="/anime/${anime.id}" class="group block w-full">
                <div class="relative aspect-[2/3] w-full rounded-xl overflow-hidden border border-gray-100 dark:border-gray-800 group-hover:border-blue-500/50 transition-colors bg-white dark:bg-gray-950">
                    <img src="${anime.coverImage.large}" loading="lazy" alt="${anime.title.romaji}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                    <div class="absolute top-2 right-2 bg-gray-950/80 backdrop-blur-md px-1.5 py-0.5 rounded flex items-center gap-1 text-yellow-400 text-[10px] font-bold border border-white/10">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                        ${anime.averageScore ? (anime.averageScore / 10).toFixed(1) : "?"}
                    </div>
                </div>
                <div class="mt-3 space-y-1">
                    <h3 class="text-xs md:text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] group-hover:text-blue-500">${anime.title?.romaji || anime.title?.english}</h3>
                    <p class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider truncate">${anime.format || "TV"} • ${anime.genres?.[0] || "Anime"}</p>
                </div>
            </a>
          `,
            )
            .join("");
        } else if (grid) {
          grid.innerHTML = `<div class="col-span-full py-20 text-center text-gray-500 font-medium">Aucun résultat trouvé pour "${query}"</div>`;
        }
      } catch (err) {
        console.error(err);
        if (grid)
          grid.innerHTML = `<div class="col-span-full py-20 text-center text-red-500 font-medium">Une erreur est survenue lors de la recherche.</div>`;
      }
    }, 400);
  });
</script>
