---
import Layout from "../layouts/Layout.astro";
import { Search as SearchIcon } from "lucide-astro";
---

<Layout title="Recherche">
  <div
    class="max-w-screen-xl mx-auto px-4 py-8 min-h-[80vh] space-y-8 mt-4 md:mt-8"
  >
    <!-- Search Header -->
    <div class="relative max-w-2xl mx-auto">
      <div
        class="absolute inset-y-0 start-0 flex items-center ps-5 pointer-events-none"
      >
        <SearchIcon class="text-blue-500" size={24} />
      </div>
      <input
        type="text"
        id="search-input"
        class="block w-full p-5 ps-14 text-lg text-gray-900 border border-gray-200 rounded-3xl bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 dark:bg-gray-950 dark:border-gray-800 dark:placeholder-gray-400 dark:text-white shadow-2xl transition-all"
        placeholder="Rechercher un anime..."
        autofocus
      />
    </div>

    <!-- Results Area -->
    <div
      id="results-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8"
    >
      <div class="col-span-full py-24 text-center space-y-6">
        <div
          class="inline-flex items-center justify-center w-24 h-24 bg-gray-50 dark:bg-gray-900 rounded-[2.5rem] text-gray-300 dark:text-gray-700"
        >
          <SearchIcon size={48} />
        </div>
        <div class="space-y-2">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">
            Prêt à regarder ?
          </h2>
          <p class="text-gray-500 dark:text-gray-400 font-medium">
            Tapez le nom d'un anime pour explorer la bibliothèque
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let debounceTimer: any;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const grid = document.getElementById("results-grid");

  input?.addEventListener("input", (e) => {
    clearTimeout(debounceTimer);
    const target = e.target as HTMLInputElement;
    const query = target.value;

    if (query.trim().length < 2) {
      if (grid)
        grid.innerHTML = `
        <div class="col-span-full py-24 text-center space-y-6">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-gray-50 dark:bg-gray-900 rounded-[2.5rem] text-gray-300 dark:text-gray-700">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <div class="space-y-2">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">Prêt à regarder ?</h2>
              <p class="text-gray-500 dark:text-gray-400 font-medium">Tapez le nom d'un anime pour explorer la bibliothèque</p>
            </div>
        </div>
      `;
      return;
    }

    debounceTimer = setTimeout(async () => {
      if (grid)
        grid.innerHTML = `
            <div class="col-span-full py-24 text-center space-y-4">
                <div class="inline-flex items-center justify-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-500 border-t-transparent"></div>
                </div>
                <p class="text-gray-500 dark:text-gray-400 font-medium">Exploration de la base de données...</p>
            </div>
      `;

      try {
        const queryGraphQL = `
          query ($search: String) {
            Page(perPage: 30) {
              media(search: $search, type: ANIME, sort: POPULARITY_DESC) {
                id
                title { romaji english }
                coverImage { large }
                format
                genres
              }
            }
          }
        `;

        const res = await fetch("https://graphql.anilist.co", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            query: queryGraphQL,
            variables: { search: query },
          }),
        });

        const { data } = await res.json();

        if (grid && data.Page.media.length > 0) {
          grid.innerHTML = data.Page.media
            .map(
              (anime: any) => `
            <a href="/anime/${anime.id}" class="group block w-full">
                <div class="relative aspect-[2/3] w-full rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-800/50 transition-colors bg-white dark:bg-gray-950">
                    <img src="${anime.coverImage.large}" loading="lazy" alt="${anime.title.romaji}" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105" />
                </div>
                <div class="mt-3 px-1">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 line-clamp-2 leading-tight min-h-[2.5rem] transition-colors">${anime.title?.romaji || anime.title?.english}</h3>
                    <p class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-1">${anime.format || "TV"} • ${anime.genres?.[0] || "Anime"}</p>
                </div>
            </a>
          `,
            )
            .join("");
        } else if (grid) {
          grid.innerHTML = `<div class="col-span-full py-24 text-center text-gray-500 font-medium">Désolé, nous n'avons rien trouvé pour "${query}"</div>`;
        }
      } catch (err) {
        console.error(err);
        if (grid)
          grid.innerHTML = `<div class="col-span-full py-24 text-center text-red-500 font-medium">Oups ! Une erreur réseau est survenue.</div>`;
      }
    }, 400);
  });
</script>
